---
import Header from '../components/Header/Header';
import Footer from '../components/Footer/Footer';
import { ClientRouter } from "astro:transitions";
import "../global.css"
const pathname = Astro.url.pathname;

interface Props {
  title: string;
  description: string;
  url: string
}
const { title, description, url } = Astro.props;
---

<!DOCTYPE html>
<html lang="es" transition:name="root" transition:animate="none">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="icon" type="image/x-icon" href="public/vincode-icon.ico" />
  	<link rel="shortcut icon" type="image/x-icon" href="/vincode-icon.ico">
    <title>{title}</title>
    <meta name="description" content={description}>
    <link
          rel="canonical"
          href={url}
        />
    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:image" content="/cover-page.webp" />
    <meta
        property="og:description"
        content={description}
    />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={url}></meta>
    <ClientRouter fallback='none' />
  </head>

   <script>
    (() => {
      const scrollToHash = () => {
        if (!location.hash) return;
        const targetId = location.hash.slice(1);
        let attempts = 0;
        const maxAttempts = 30;
        const tryScroll = () => {
          const el = document.getElementById(targetId);
          if (!el) {
            if (attempts < maxAttempts) {
              attempts++;
              return requestAnimationFrame(tryScroll);
            }
            return;
          }
          // Ajusta este valor si tienes un header fijo de diferente altura
          const headerOffset = 64; // px
          const y = el.getBoundingClientRect().top + window.scrollY - headerOffset;
          window.scrollTo({ top: y, behavior: "smooth" });
        };
        requestAnimationFrame(tryScroll);
      };
      window.addEventListener("pageshow", scrollToHash);
      window.addEventListener("hashchange", scrollToHash);
      // Si ya hay hash al cargar
      if (location.hash) {
        scrollToHash();
      }
    })();
    </script>


  <body class="w-full mx-auto min-w-80 min-h-dvh bg-background-dark text-text-primary font-Manrope">
    <div id="home" class="grid grid-rows-[1fr_auto] min-h-dvh">
      <Header initialPathname={pathname}/>
      <main class="w-dvw md:w-full place-items-center">
        <slot />
      </main>
      <Footer initialPathname={pathname}/>
    </div>
  </body>

  <style is:global>
    html {
      scroll-behavior: smooth;
      scroll-padding-top: 4rem;
    }
  </style>


</html>