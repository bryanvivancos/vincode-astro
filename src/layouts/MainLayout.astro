---
import Header from "../components/Header/Header";
import Footer from "../components/Footer/Footer";
import MobileNav from "../components/Header/MobileNav"
import { ClientRouter } from "astro:transitions";
import Analytics from '@vercel/analytics/astro';
import "../global.css";
const pathname = Astro.url.pathname;

interface Props {
    title: string;
    description: string;
    url: string;
}
const { title, description, url } = Astro.props;
---

<!doctype html>
<html lang="es" transition:name="root" transition:animate="none">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <link rel="icon" type="image/x-icon" href="/vincode-icon.ico" />
        <link
            rel="shortcut icon"
            type="image/x-icon"
            href="/vincode-icon.ico"
        />
        <title>{title}</title>
        <meta name="description" content={description} />
        <link rel="canonical" href={url} />
        <!-- Open Graph -->
        <meta property="og:title" content={title} />
        <meta property="og:image" content="/cover-page.webp" />
        <meta property="og:description" content={description} />
        <meta property="og:type" content="website" />
        <meta property="og:url" content={url} />
        <style is:inline>
            /* Reemplaza #000 con el color exacto de tu variable bg-background-dark */
            html {
                background-color: #0d0d0d; 
                color: #ffffff;
            }
        </style>
        <ClientRouter/>
        <Analytics />
    </head>
    
    <body
    class="mx-auto min-w-80 min-h-dvh bg-background-dark text-text-primary font-Manrope"
    >
        <div id="home" class="grid grid-rows-[1fr_auto] min-h-dvh">
            <Header currentPath={pathname} client:load />
            <MobileNav currentPath={pathname} client:load/>

            <main class="w-dvw md:w-full place-items-center" transition:animate="fade">
                <slot />
            </main>
            <Footer currentPath={pathname} />
        </div>
    </body>
</html>
