---
import "../global.css";
import Header from "../components/Header/Header";
import MobileNav from "../components/Header/MobileNav";
import Analytics from "@vercel/analytics/astro";
import FooterComponent from "../components/Footer/FooterComponent.astro";
import { ClientRouter } from "astro:transitions";
const pathname = Astro.url.pathname;

interface Props {
    title: string;
    description: string;
    url: string;
    keywords?: string;
}
const { title, description, url, keywords } = Astro.props;
---

<!doctype html>
<html lang="es" transition:animate="none">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <link rel="icon" type="image/x-icon" href="/vincode-icon.ico" />
        <link
            rel="shortcut icon"
            type="image/x-icon"
            href="/vincode-icon.ico"
        />
        <title>{title}</title>
        <meta name="description" content={description} />
        <meta name="keywords" content={keywords} />
        <link rel="canonical" href={url} />
        <!-- Open Graph -->
        <meta property="og:title" content={title} />
        <meta property="og:image" content="/cover-page.webp" />
        <meta property="og:description" content={description} />
        <meta property="og:type" content="website" />
        <meta property="og:url" content={url} />
        <style is:inline>
            html {
                background-color: #0d0f14;
                color: #ffffff;
            }
        </style>
        <Analytics />
        <ClientRouter fallback="none" />
    </head>

    <body
        class="mx-auto min-w-80 min-h-dvh bg-background-dark text-text-primary font-Manrope"
    >
        <div id="home" class="grid grid-rows-[1fr_auto] min-h-dvh">
            <Header currentPath={pathname} client:load />
            <MobileNav currentPath={pathname} client:load />

            <main class="w-dvw md:w-full place-items-center">
                <slot />
            </main>
            <FooterComponent />
        </div>

        <script is:inline>
            // Intersection Observer para animaciones fade-in-up
            const observer = new IntersectionObserver(
                (entries) => {
                    entries.forEach((entry) => {
                        if (entry.isIntersecting) {
                            entry.target.classList.add("visible");
                        }
                    });
                },
                {
                    threshold: 0.1,
                    rootMargin: "0px 0px -50px 0px",
                },
            );

            document.querySelectorAll(".fade-in-up").forEach((el) => {
                observer.observe(el);
            });

            // Re-observe después de navegación con View Transitions
            document.addEventListener("astro:page-load", () => {
                document.querySelectorAll(".fade-in-up").forEach((el) => {
                    observer.observe(el);
                });
            });
        </script>
    </body>
</html>
