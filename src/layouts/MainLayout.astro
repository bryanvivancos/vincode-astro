---
import Header from '../components/Header/Header';
import Footer from '../components/Footer/Footer';
import "../global.css"
const pathname = Astro.url.pathname;

interface Props {
  title: string;
  description: string;
  url: string
}
const { title, description, url } = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="icon" type="image/x-icon" href="public/vincode-icon.ico" />
  	<link rel="shortcut icon" type="image/x-icon" href="/vincode-icon.ico">
    <title>{title}</title>
    <meta name="description" content={description}>
    <link
          rel="canonical"
          href={url}
        />
    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:image" content="/cover-page.webp" />
    <meta
        property="og:description"
        content={description}
    />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={url}></meta>
  </head>

  <body class=" m-0 min-w-80 min-h-dvh bg-background-dark text-text-primary font-Manrope">
    <div id="home" class="grid grid-rows-[1fr_auto] min-h-dvh">
      <Header initialPathname={pathname}/>
      <main class="w-dvw md:w-full place-items-center">
        <slot />
      </main>
      <Footer initialPathname={pathname}/>
    </div>
  </body>

  <style>
    h1 {
      font-size: 2rem;
    }
  </style>

  <script>
    const state = history.state;

    if (state?.scrollTo) {
      requestAnimationFrame(() => {
        const el = document.getElementById(state.scrollTo);

        if (el) {
          el.scrollIntoView({
            behavior: 'smooth',
            block: 'start',
          });
        }
      });
    }
  </script>
</html>