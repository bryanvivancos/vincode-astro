---
import { CheckIcon, ExternalLinkIcon } from "../../components/icons";
import { BRAND_NAME } from "../../CONSTANTS";
import MainLayout from "../../layouts/MainLayout.astro";
import CTABanner from "../../components/CTABanner/CTABanner.astro";

const pilares = [
    {
        name: "Vanguardia",
        text: "Tecnología moderna y en constante evolución.",
    },
    {
        name: "Excelencia Técnica",
        text: "Soluciones sólidas, seguras y bien construidas.",
    },
    {
        name: "Empatía Estratégica",
        text: "Cada proyecto se adapta a necesidades reales.",
    },
    {
        name: "Confianza Radical",
        text: "Comunicación clara y acompañamiento continuo.",
    },
];

const beneficios = [
    {
        title: "Cero Plantillas",
        text: "Diseñamos soluciones a la medida, no genéricas de talla única.",
    },
    {
        title: "Stack Moderno",
        text: "Utilizamos las tecnologías más eficientes y potentes del mercado actual.",
    },
    {
        title: "Visión de Negocio",
        text: "Entendemos que la tecnología es un medio para aumentar tus ingresos y eficiencia.",
    },
    {
        title: "Socio Tecnológico",
        text: "No te entregamos un proyecto y nos vamos; te acompañamos en tu evolución digital.",
    },
    {
        title: "Enfoque en Resultados",
        text: "Creamos herramientas que se traducen en crecimiento tangible.",
    },
];

export const prerender = true;
---

<MainLayout
    title={`Sobre Nosotros | ${BRAND_NAME}`}
    description={`En ${BRAND_NAME} convertimos código en impacto real para tu negocio.`}
    url="www.vincode.dev/about-us"
    keywords="Sobre nosotros, Misión, Visión, Valores, Equipo, Vincode, Bryan Vivanco, Bryan Vivanco Silva"
>
    <!-- Hero de página -->
    <section class="section-spacing">
        <div class="section-container">
            <div class="text-center max-w-3xl mx-auto">
                <p class="eyebrow">Sobre Nosotros</p>
                <h1 class="sectionTitle mb-6">Nuestra Identidad</h1>
                <p class="section-subtitle mx-auto">
                    <span class="text-text-primary font-semibold"
                        >En VINCODE convertimos código en impacto real para tu
                        negocio.</span
                    >
                    Creamos soluciones digitales modernas que ayudan a negocios y
                    profesionales a crecer, optimizar procesos y destacar en el entorno
                    digital. Desarrollamos tecnología funcional, escalable y pensada
                    para generar resultados reales.
                </p>
            </div>
        </div>
    </section>

    <!-- Misión y Visión -->
    <section class="section-alt">
        <div class="section-container section-spacing">
            <div class="grid md:grid-cols-2 gap-6">
                <div class="service-card">
                    <p class="eyebrow mb-2">Misión</p>
                    <h3
                        class="text-2xl md:text-3xl font-bold text-text-primary mb-4"
                    >
                        Lo que nos mueve
                    </h3>
                    <p class="about-text">
                        Crear soluciones digitales innovadoras y personalizadas
                        que impulsen el crecimiento de nuestros clientes a
                        través de la tecnología.
                    </p>
                </div>

                <div class="service-card">
                    <p class="eyebrow mb-2">Visión</p>
                    <h3
                        class="text-2xl md:text-3xl font-bold text-text-primary mb-4"
                    >
                        Hacia dónde vamos
                    </h3>
                    <p class="about-text">
                        Ser un referente en desarrollo tecnológico, creando
                        soluciones digitales que acompañen la evolución de
                        empresas y emprendedores.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- Nuestros Pilares -->
    <section>
        <div class="section-container section-spacing">
            <div class="text-center mb-12">
                <h2 class="sectionTitle">Nuestros Pilares</h2>
            </div>
            <div class="grid grid-cols-2 md:grid-cols-4 gap-5">
                {
                    pilares.map((pilar) => (
                        <div class="service-card text-center group fade-in-up">
                            <p class="text-lg font-bold text-text-primary group-hover:text-primary transition-colors duration-200 mb-2">
                                {pilar.name}
                            </p>
                            <p class="text-sm text-text-secondary leading-relaxed">
                                {pilar.text}
                            </p>
                        </div>
                    ))
                }
            </div>
        </div>
    </section>

    <!-- Detrás de VINCODE -->
    <section class="section-alt">
        <div class="section-container section-spacing">
            <div class="grid md:grid-cols-2 gap-12 items-center">
                <div class="flex justify-center items-center">
                    <img
                        src="/profile.webp"
                        alt="Bryan Vivanco - Fundador de VINCODE"
                        class="w-70 h-70 md:w-90 md:h-90 object-cover rounded-2xl"
                    />
                </div>
                <div class="space-y-5">
                    <h2 class="sectionTitle">Detrás de VINCODE</h2>
                    <p class="about-text">
                        Hola, soy <span class="text-text-primary font-semibold"
                            >Bryan Vivanco</span
                        >, fundador de VINCODE y desarrollador apasionado por la
                        tecnología y el emprendimiento.
                    </p>
                    <p class="about-text">
                        Mi enfoque es integral: no solo escribo código, resuelvo
                        problemas de negocio. Combino el rigor de la ingeniería
                        con una visión estratégica para asegurar que cada
                        producto sea una inversión rentable, sólida y preparada
                        para el futuro.
                    </p>
                    <p class="about-text">
                        Trato cada proyecto con la dedicación de un socio
                        tecnológico, cuidando cada detalle para que tú solo te
                        preocupes por hacer crecer tu marca.
                    </p>
                    <a
                        href="https://bryanvivancos.netlify.app/"
                        class="text-primary font-semibold inline-flex items-center gap-2 hover:gap-3 transition-all duration-200 mt-2"
                        target="_blank"
                    >
                        Puedes ver más de mí en mi portfolio <span>→</span>
                    </a>
                </div>
            </div>
        </div>
    </section>

    <!-- ¿Por qué elegirnos? -->
    <section>
        <div class="section-container section-spacing">
            <div class="text-center mb-12">
                <h2 class="sectionTitle">¿Por Qué Elegirnos?</h2>
            </div>
            <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-5">
                {
                    beneficios.map((beneficio) => (
                        <div class="service-card flex gap-4 items-start fade-in-up">
                            <div class="w-10 h-10 rounded-xl bg-primary/10 flex items-center justify-center shrink-0">
                                <CheckIcon />
                            </div>
                            <div>
                                <p class="text-lg font-bold text-text-primary mb-2">
                                    {beneficio.title}
                                </p>
                                <p class="text-sm text-text-secondary leading-relaxed">
                                    {beneficio.text}
                                </p>
                            </div>
                        </div>
                    ))
                }
            </div>
        </div>
    </section>

    <CTABanner
        title="Contáctanos"
        description="¿Listo para llevar tu negocio al siguiente nivel? Hablemos sobre tu proyecto."
        buttonText="Contáctanos"
        buttonHref="/contact"
    />
</MainLayout>
