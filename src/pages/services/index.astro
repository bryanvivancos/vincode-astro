---
import { icons } from "../../components/icons";
import ServiceItem from "../../components/Services/ServiceItem.astro";
import CTABanner from "../../components/CTABanner/CTABanner.astro";
import { BRAND_NAME, SERVICES_TITLE } from "../../CONSTANTS";
import MainLayout from "../../layouts/MainLayout.astro";
import { getCollection } from "astro:content";

const services = (await getCollection("services")).sort((a, b) => {
    if (a.data.available !== b.data.available) {
        return a.data.available ? -1 : 1;
    }
    return a.data.id - b.data.id;
});

export const prerender = true;
---

<MainLayout
    title={`Servicios | ${BRAND_NAME}`}
    description={`En ${BRAND_NAME} ofrecemos una gama de servicios para satisfacer tus necesidades digitales.`}
    url="www.vincode.dev/services"
    keywords="Servicios digitales, Desarrollo web, Desarrollo de software, Vincode, Soluciones digitales"
>
    <!-- Hero de página -->
    <section class="section-spacing">
        <div class="section-container">
            <div class="text-center max-w-3xl mx-auto">
                <p class="eyebrow">Nuestros Servicios</p>
                <h1 class="sectionTitle mb-6">{SERVICES_TITLE}</h1>
                <p class="section-subtitle mx-auto">
                    Ofrecemos una gama de servicios para satisfacer tus
                    necesidades digitales, desde la creación de tarjetas
                    digitales, portfolios hasta el desarrollo de un software a
                    la medida de tu negocio.
                    <span class="text-primary font-semibold"
                        >¡Y pronto... tu propia Web Ecommerce!</span
                    >
                </p>
            </div>
        </div>
    </section>

    <!-- Desarrollo Web -->
    <section class="section-alt xl:rounded-xl">
        <div class="section-container section-spacing">
            <div class="mb-12">
                <h2
                    class="text-3xl md:text-4xl font-bold text-text-primary mb-4"
                >
                    Desarrollo Web
                </h2>
                <p class="section-subtitle">
                    Creamos sitios a medida, desde páginas informativas hasta
                    plataformas complejas. Nos enfocamos en la usabilidad, el
                    diseño responsivo y la optimización para motores de búsqueda
                    (SEO).
                </p>
            </div>

            <ServiceItem services={services} itemCategory="web" icons={icons} />
        </div>
    </section>

    <!-- Desarrollo de Software -->
    <section>
        <div class="section-container section-spacing">
            <div class="mb-12">
                <h2
                    class="text-3xl md:text-4xl font-bold text-text-primary mb-4"
                >
                    Desarrollo de Software
                </h2>
                <p class="section-subtitle">
                    Desarrollamos software personalizado para automatizar
                    procesos o agilizar procedimientos que hagan rendir mejor y
                    optimizar tu negocio.
                </p>
            </div>

            <ServiceItem
                services={services}
                itemCategory="software"
                icons={icons}
            />
        </div>
    </section>

    <CTABanner
        title="Solicitar Cotización"
        description="¿Interesado en alguno de nuestros servicios? Contáctanos para obtener una cotización personalizada."
        buttonText="Solicitar Cotización"
        buttonHref="/contact"
    />
</MainLayout>
