---
import { icons } from "../../components/icons";
import type { IconName } from "../../components/icons";
import ServiceItem from "../../components/Services/ServiceItem.astro";
import { BRAND_NAME, SERVICES_TITLE } from "../../CONSTANTS";
import MainLayout from "../../layouts/MainLayout.astro";
import { getCollection } from "astro:content";

const services = (await getCollection("services")).sort((a, b) => {
    // (a, b) => a.data.id - b.data.id
    // 1. Prioridad por disponibilidad (disponibles primero)
    // Convertimos booleanos a números para restar: true -> 1, false -> 0
    // Queremos que el 1 (disponible) vaya antes que el 0 (no disponible)
    if (a.data.available !== b.data.available) {
        return a.data.available ? -1 : 1;
    }

    // 2. Si ambos tienen la misma disponibilidad, ordenamos por ID
    return a.data.id - b.data.id;
});

export const prerender = true;
---

<MainLayout
    title={`Servicios | ${BRAND_NAME}`}
    description={`En ${BRAND_NAME} ofrecemos una gama de servicios para satisfacer tus necesidades digitales.`}
    url="www.vincode.dev/services"
    keywords="Servicios digitales, Desarrollo web, Desarrollo de software, Vincode, Soluciones digitales"
>
    <main
        class="section-spacing w-full flex flex-col justify-center items-center"
    >
        <div class="section-container">
            <div class="flex flex-col gap-8 sm:gap-10 md:gap-12">
                <div class="flex flex-col gap-4 mb-4">
                    <p
                        class="text-sm sm:text-base font-semibold tracking-wider text-primary uppercase"
                    >
                        Nuestros Servicios
                    </p>
                    <h1 class="sectionTitle text-4xl md:text-5xl">
                        {SERVICES_TITLE}
                    </h1>
                    <p
                        class="text-base sm:text-lg font-medium leading-relaxed text-text-secondary max-w-3xl"
                    >
                        Ofrecemos una gama de servicios para satisfacer tus
                        necesidades digitales, desde la creación de tarjetas
                        digitales, portfolios hasta el desarrollo de un software
                        a la medida de tu negocio.<br />
                        <span class="text-primary font-semibold"
                            >Y pronto... Tu propia Web Ecommerce!</span
                        >
                    </p>
                </div>

                <div class="space-y-4">
                    <h2
                        class="text-2xl md:text-3xl font-bold text-text-primary"
                    >
                        Desarrollo Web
                    </h2>
                    <p
                        class="text-base font-medium leading-relaxed text-text-secondary max-w-2xl"
                    >
                        Creamos sitios a medida, desde páginas informativas
                        hasta plataformas complejas. Nos enfocamos en la
                        usabilidad, el diseño responsivo y la optimización para
                        motores de búsqueda (SEO).
                    </p>
                </div>

                <ServiceItem
                    services={services}
                    itemCategory="web"
                    icons={icons}
                />

                <div class="space-y-4">
                    <h2
                        class="text-2xl md:text-3xl font-bold text-text-primary"
                    >
                        Desarrollo de Software
                    </h2>

                    <p
                        class="text-base font-medium leading-relaxed text-text-secondary max-w-2xl"
                    >
                        Desarrollamos software personalizado para automatizar
                        procesos o agilizar procedimientos que hagan rendir
                        mejor y optimizar tu negocio.
                    </p>
                </div>

                <ServiceItem
                    services={services}
                    itemCategory="software"
                    icons={icons}
                />
            </div>
        </div>

        <div class="flex justify-center mt-8">
            <a href="/contact" class="btn-primary text-base md:text-lg">
                Solicitar Cotización
            </a>
        </div>
    </main>
</MainLayout>
