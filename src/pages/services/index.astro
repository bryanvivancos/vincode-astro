---
import { icons } from "../../components/icons";
import ServiceItem from "../../components/Services/ServiceItem.astro";
import CTABanner from "../../components/CTABanner/CTABanner.astro";
import { BRAND_NAME, SERVICES_TITLE } from "../../CONSTANTS";
import MainLayout from "../../layouts/MainLayout.astro";
import { getCollection } from "astro:content";

const services = (await getCollection("services")).sort((a, b) => {
    if (a.data.available !== b.data.available) {
        return a.data.available ? -1 : 1;
    }
    return a.data.id - b.data.id;
});

export const prerender = true;
---

<MainLayout
    title={`Servicios | ${BRAND_NAME}`}
    description={`En ${BRAND_NAME} ofrecemos una gama de servicios para satisfacer tus necesidades digitales.`}
    keywords="Servicios digitales, Desarrollo web, Desarrollo de software, Vincode, Soluciones digitales"
>
    <!-- Hero de página -->
    <section class="section-spacing">
        <div class="section-container">
            <div class="text-center max-w-3xl mx-auto">
                <p class="eyebrow">Transforma tu Negocio</p>
                <h1 class="sectionTitle mb-6">{SERVICES_TITLE}</h1>
                <p class="section-subtitle mx-auto">
                    De la idea al lanzamiento. Creamos soluciones digitales que
                    impulsan tu crecimiento: <span
                        class="text-primary font-semibold"
                        >portfolios que venden, tarjetas digitales que
                        impresionan y software que automatiza.</span
                    > Todo diseñado para que destaques en el mundo digital.
                </p>
            </div>
        </div>
    </section>

    <!-- Desarrollo Web -->
    <section class="section-alt xl:rounded-xl">
        <div class="section-container section-spacing">
            <div class="mb-12">
                <h2
                    class="text-3xl md:text-4xl font-bold text-text-primary mb-4"
                >
                    Desarrollo Web
                </h2>
                <p class="section-subtitle">
                    Tu presencia digital empieza aquí. Diseñamos sitios web que
                    convierten visitantes en clientes: <span
                        class="text-primary font-semibold"
                        >rápidos, responsivos y optimizados para Google.</span
                    > Desde portfolios profesionales hasta poderosas Landing Page.
                </p>
            </div>

            <ServiceItem services={services} itemCategory="web" icons={icons} />
        </div>
    </section>

    <!-- Desarrollo de Software -->
    <section>
        <div class="section-container section-spacing">
            <div class="mb-12">
                <h2
                    class="text-3xl md:text-4xl font-bold text-text-primary mb-4"
                >
                    Desarrollo de Software
                </h2>
                <p class="section-subtitle">
                    Automatiza lo repetitivo, enfócate en crecer. Construimos
                    software a medida que <span
                        class="text-primary font-semibold"
                        >ahorra tiempo, reduce errores y escala con tu negocio.</span
                    > Soluciones inteligentes para desafíos únicos.
                </p>
            </div>

            <ServiceItem
                services={services}
                itemCategory="software"
                icons={icons}
            />
        </div>
    </section>

    <CTABanner
        title="¿Listo para despegar?"
        description="Cuéntanos tu idea y te mostramos cómo hacerla realidad. Cotización sin compromiso en menos de 24 horas."
        buttonText="Empecemos Ahora"
        buttonHref="/contact"
    />
</MainLayout>
