---
import { Toaster } from "react-hot-toast";
import ContactForm from "../../components/ContactForm/ContactForm";
import { BRAND_NAME } from "../../CONSTANTS";
import MainLayout from "../../layouts/MainLayout.astro";

export const prerender = true;
---

<MainLayout
    title={`Contacto | ${BRAND_NAME}`}
    description={`Haznos las consultas que desees y te acompañamos en el camino para crecer digitalmente tu negocio o marca personal.`}
    url="www.vincode.dev/contact"
    keywords="Contacto, Soporte, Consultas, Vincode, Asistencia al cliente"
>
    <section class="py-10 px-4">
        <ContactForm client:visible />
    </section>
    <Toaster client:visible />
</MainLayout>
