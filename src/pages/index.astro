---
import Hero from "../components/Hero/Hero";
import Services from "../components/Services/Services.astro";
import Projects from "../components/Projects/Projects.astro";
import OtherProjects from "../components/OtherProjects/OtherProjects";
import ContactForm from "../components/ContactForm/ContactForm";
import { BRAND_NAME } from "../CONSTANTS";
import MainLayout from "../layouts/MainLayout.astro";
import "../global.css";
import { Toaster } from "react-hot-toast";
---

<MainLayout
    title={`${BRAND_NAME} | Eleva tu presencia digital`}
    description="Vincode es un equipo de desarrollo de software que ofrece soluciones personalizadas para emprendimientos, startups y autónomos."
    url="www.vincode.dev"
>
    <Hero client:load />
    <div class="px-4">
        <Services />
        <Projects />
        <div id="other-projects">
            <OtherProjects client:load />
        </div>
        <div class="flex flex-col gap-8 text-center">
            <p class="text-primary font-extrabold text-2xl md:text-4xl">¿LISTO PARA EMPEZAR?</p>
            <p class="text-center text-base tmd:text-lg text-balance ">Contáctanos hoy para discutir tu proyecto y descubrir como podemos ayudarte con tus metas digitales.</p>
            <div class="flex justify-center">
                <a href="/contact" class="py-2 md:py-3 px-3 sm:px-4 md:px-5 bg-primary rounded-lg text-base sm:text-sm font-bold text-text-primary transition-all duration-300 ease-in-out hover:bg-[#0090c7] hover:transform hover:-translate-y-0.5">Contáctanos</a>
            </div>
        </div>
    </div>
    <Toaster client:load />
</MainLayout>
