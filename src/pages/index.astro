---
import Hero from "../components/Hero/Hero";
import Services from "../components/Services/Services.astro";
import Projects from "../components/Projects/Projects.astro";
import OtherProjects from "../components/OtherProjects/OtherProjects";
import { BRAND_NAME } from "../CONSTANTS";
import MainLayout from "../layouts/MainLayout.astro";

export const prerender = true;
---

<MainLayout
    title={`${BRAND_NAME} | Eleva tu presencia digital`}
    description={`Eleva tu presencia digital con nuestras soluciones personalizadas para emprendimientos, startups y autónomos.`}
    url="www.vincode.dev"
    keywords="Desarrollo web, Diseño web, Soluciones digitales, Emprendimientos, Startups, Autónomos, Vincode, Presencia digital, Servicios web"
>
    <Hero client:load />
    <div class="parallax-offset">
        <Services />
        <Projects />
        <OtherProjects client:visible />

        <section class="section-spacing w-full flex justify-center">
            <div class="section-container text-center">
                <div
                    class="card-elegant-contact max-w-3xl mx-auto p-0 py-12 px-6 md:py-16 md:px-12 bg-gradient-to-br from-background-card to-background-dark"
                >
                    <p
                        class="text-primary font-bold text-3xl md:text-4xl lg:text-5xl tracking-tight mb-6"
                    >
                        ¿Listo para empezar?
                    </p>
                    <p
                        class="text-text-secondary text-base md:text-lg text-balance max-w-xl mx-auto mb-8 leading-relaxed"
                    >
                        Contáctanos hoy para discutir tu proyecto y descubrir
                        cómo podemos ayudarte con tus metas digitales.
                    </p>
                    <a
                        href="/contact"
                        class="btn-primary inline-block text-base md:text-lg"
                    >
                        Contáctanos
                    </a>
                </div>
            </div>
        </section>
    </div>
</MainLayout>
