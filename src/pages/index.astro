---
import Hero from "../components/Hero/Hero";
import Services from "../components/Services/Services.astro";
import Projects from "../components/Projects/Projects.astro";
import OtherProjects from "../components/OtherProjects/OtherProjects";
import Stats from "../components/Stats/Stats.astro";
import CTABanner from "../components/CTABanner/CTABanner.astro";
import { BRAND_NAME } from "../CONSTANTS";
import MainLayout from "../layouts/MainLayout.astro";

export const prerender = true;
---

<MainLayout
    title={`${BRAND_NAME} | Eleva tu presencia digital`}
    description={`Eleva tu presencia digital con nuestras soluciones personalizadas para emprendimientos, startups y autónomos.`}
    url="www.vincode.dev"
    keywords="Desarrollo web, Diseño web, Soluciones digitales, Emprendimientos, Startups, Autónomos, Vincode, Presencia digital, Servicios web"
>
    <Hero client:load />
    <div class="parallax-offset">
        <Services />
        <Stats />
        <Projects />
        <OtherProjects client:visible />
        <CTABanner
            eyebrow="¿Listo para empezar?"
            title="Contáctanos hoy para discutir tu proyecto"
            description="Descubre cómo podemos ayudarte a alcanzar tus metas digitales."
            buttonText="Contáctanos"
            buttonHref="/contact"
        />
    </div>
</MainLayout>
