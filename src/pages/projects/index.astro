---
import ProjectGrid from "../../components/atoms/ProjectGrid.astro";
import { BRAND_NAME, others_projects, projects } from "../../CONSTANTS";
import MainLayout from "../../layouts/MainLayout.astro";

export const prerender = true;
---

<MainLayout
    title={`Proyectos | ${BRAND_NAME}`}
    description={`Explora algunos de nuestros proyectos recientes completados con exito para nuestros clientes.`}
    url="www.vincode.dev/projects"
    keywords="Proyectos, Portafolio, Desarrollo web, Vincode, Casos de estudio"
>
    <!-- Hero de página -->
    <section class="section-spacing">
        <div class="section-container">
            <div class="text-center max-w-3xl mx-auto">
                <p class="eyebrow">Nuestro Trabajo</p>
                <h1 class="sectionTitle mb-6">Proyectos Realizados</h1>
                <p class="section-subtitle mx-auto">
                    Explora algunos de nuestros proyectos recientes completados
                    con éxito para nuestros clientes.
                </p>
            </div>
        </div>
    </section>

    <!-- Grid principal -->
    <section class="section-alt w-full">
        <div class="section-container section-spacing">
            <ProjectGrid projects={projects} client:visible />
        </div>
    </section>

    <!-- Otros proyectos -->
    <section>
        <div class="section-container section-spacing">
            <div class="text-center mb-12">
                <h2 class="sectionTitle mb-6">
                    Otros Proyectos de {BRAND_NAME}
                </h2>
                <p class="section-subtitle mx-auto">
                    Explora otros de los proyectos realizados por nosotros.
                </p>
            </div>

            <ProjectGrid projects={others_projects} client:visible />
        </div>
    </section>
</MainLayout>
