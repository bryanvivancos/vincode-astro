---
import ProjectGrid from "../../components/atoms/ProjectGrid.astro";
import { BRAND_NAME, others_projects, projects } from "../../CONSTANTS";
import MainLayout from "../../layouts/MainLayout.astro";

export const prerender = true;
---

<MainLayout
    title={`Proyectos | ${BRAND_NAME}`}
    description={`Explora algunos de nuestros proyectos recientes completados con exito para nuestros clientes.`}
    url="www.vincode.dev/projects"
    keywords="Proyectos, Portafolio, Desarrollo web, Vincode, Casos de estudio"
>
    <main class="section-spacing w-full flex flex-col items-center">
        <div class="section-container">
            <p
                class="text-sm sm:text-base font-semibold tracking-wider text-primary uppercase mb-3"
            >
                Nuestro Trabajo
            </p>
            <h1 class="sectionTitle text-4xl md:text-5xl">
                Proyectos Realizados
            </h1>

            <p
                class="text-base sm:text-lg font-medium leading-relaxed text-text-secondary max-w-3xl mb-10"
            >
                Explora algunos de nuestros proyectos recientes completados con
                éxito para nuestros clientes.
            </p>

            <ProjectGrid projects={projects} client:visible />
        </div>

        <div class="section-container mt-16 md:mt-20">
            <h2 class="sectionTitle text-3xl md:text-4xl">
                Otros Proyectos de {BRAND_NAME}
            </h2>

            <p
                class="text-base sm:text-lg font-medium leading-relaxed text-text-secondary max-w-3xl mb-10"
            >
                Explora otros de los proyectos realizados por nosotros.
            </p>

            <ProjectGrid projects={others_projects} client:visible />
        </div>
    </main>
</MainLayout>
