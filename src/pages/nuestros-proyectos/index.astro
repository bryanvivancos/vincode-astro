---
import { BRAND_NAME, projects } from "../../CONSTANTS";
import MainLayout from "../../layouts/MainLayout.astro";
import GalleryReact from "../../components/atoms/Gallery";

export const prerender = true;
---

<MainLayout
    title={`Proyectos | ${BRAND_NAME}`}
    description={`Explora algunos de nuestros proyectos recientes completados con exito para nuestros clientes.`}
    keywords="Proyectos, Portafolio, Desarrollo web, Vincode, Casos de estudio"
>
    <!-- Hero de página -->
    <section class="section-spacing bg-gray-50">
        <div class="section-container">
            <div class="max-w-4xl">
                <p
                    class="text-xs md:text-sm font-semibold tracking-widest text-primary uppercase mb-4"
                >
                    Nuestro Trabajo
                </p>
                <h1
                    class="!text-3xl md:!text-4xl font-black text-text-primary mb-6 leading-[1.2]"
                >
                    Convertimos Visiones en Realidades Digitales que Generan
                    Resultados
                </h1>
                <p
                    class="text-sm md:text-base text-text-secondary leading-relaxed max-w-3xl"
                >
                    Cada proyecto es una historia de éxito. Descubre cómo
                    transformamos desafíos en soluciones digitales innovadoras
                    que impulsan negocios y conectan con audiencias reales.
                </p>
            </div>
        </div>
    </section>

    <!-- Proyectos principales -->
    <section class="bg-[#f8f8fa]">
        <div class="section-container py-20 md:py-24">
            <div class="space-y-32">
                {
                    projects.map((project, index) => (
                        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start">
                            {/* Mockups - Izquierda */}
                            <div class="space-y-6">
                                <div class="bg-gray-50 rounded-2xl p-8 shadow-lg">
                                    <GalleryReact
                                        galleryID={`project-${index}`}
                                        images={project.imgGallery}
                                        client:visible
                                    />
                                </div>
                            </div>

                            {/* Descripción - Derecha */}
                            <div class="space-y-6 lg:pt-8">
                                <div class="inline-block">
                                    <a
                                        href={project.url}
                                        target="_blank"
                                        class="text-sm font-semibold text-primary hover:text-primary-hover transition-colors flex items-center gap-2"
                                    >
                                        {project.url
                                            .replace("https://", "")
                                            .replace("http://", "")}
                                        <svg
                                            class="w-4 h-4"
                                            fill="none"
                                            stroke="currentColor"
                                            viewBox="0 0 24 24"
                                        >
                                            <path
                                                stroke-linecap="round"
                                                stroke-linejoin="round"
                                                stroke-width="2"
                                                d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
                                            />
                                        </svg>
                                    </a>
                                </div>

                                <h2 class="text-xl md:text-2xl font-bold text-text-primary leading-tight">
                                    {project.title}
                                </h2>

                                <p class="text-sm md:text-base text-text-secondary leading-relaxed">
                                    {project.description}
                                </p>

                                <div class="pt-4">
                                    <a
                                        href={project.url}
                                        target={
                                            project.goToWeb ? "_blank" : "_self"
                                        }
                                        class="inline-flex items-center gap-2 px-8 py-4 bg-primary text-white font-semibold rounded-full transition-all duration-200 hover:bg-primary-hover hover:scale-105 hover:shadow-xl"
                                    >
                                        {project.goToWeb
                                            ? "Visitar el Sitio"
                                            : "Ver detalles"}
                                        <svg
                                            class="w-5 h-5"
                                            fill="none"
                                            stroke="currentColor"
                                            viewBox="0 0 24 24"
                                        >
                                            <path
                                                stroke-linecap="round"
                                                stroke-linejoin="round"
                                                stroke-width="2"
                                                d="M17 8l4 4m0 0l-4 4m4-4H3"
                                            />
                                        </svg>
                                    </a>
                                </div>
                            </div>
                        </div>
                    ))
                }
            </div>
        </div>
    </section>
</MainLayout>
