---
import { projects } from "../../CONSTANTS";
import GalleryReact from "../atoms/Gallery";
---

<section id="projects">
    <div class="section-container section-spacing">
        <!-- Header -->
        <div class="text-center mb-16">
            <p class="eyebrow">Nuestro Trabajo</p>
            <h2 class="sectionTitle mb-6">Proyectos de Clientes</h2>
            <p class="section-subtitle mx-auto">
                Explora algunos de nuestro proyectos recientes y mira como
                podemos ayudarte a alcanzar tus metas con soluciones
                innovadoras.
            </p>
        </div>

        <!-- Grid de proyectos -->
        <div class="grid gap-10 grid-cols-1 md:grid-cols-2">
            {
                projects.map((project) => (
                    <div class="flex flex-col gap-4 group hover:shadow-lg rounded-2xl md:p-12 p-4">
                        {/* Proyecto */}

                        {/* Etiqueta lateral */}
                        <div class="flex items-center gap-3">
                            <div class="w-[2px] h-full bg-border group-hover:bg-primary transition-colors duration-200" />
                            <span class="text-text-primary group-hover:text-primary group-hover:border-primary transition-colors badge text-center border-[#f8f8fa0d] border duration-200">
                                {project.category}
                            </span>
                        </div>
                        {/* Imagen */}
                        <div class="relative overflow-hidden rounded-md">
                            <div class="transition-transform duration-300 group-hover:scale-105 aspect-video">
                                <GalleryReact
                                    galleryID="landing-gallery"
                                    images={[project.imgGallery[0]]}
                                    client:visible
                                />
                            </div>
                        </div>
                        <a
                            href={project.url}
                            target={project.goToWeb ? "_blank" : "_self"}
                            class="transition-transform duration-300 group-hover:scale-105 flex flex-col mt-4"
                        >
                            <div class="flex flex-col gap-4 h-full">
                                {/* Texto */}
                                <div class="flex flex-col gap-2">
                                    <h2 class="text-xl md:text-2xl lg:text-3xl font-bold text-text-primary group-hover:text-primary transition-colors duration-200">
                                        {project.title}
                                    </h2>

                                    <p class="text-sm md:text-lg text-text-secondary max-w-2xl mx-auto">
                                        {project.description}
                                    </p>
                                </div>
                                <div class="text-base font-semibold text-primary flex gap-1 group-hover:gap-2 transition-all duration-200">
                                    {project.goToWeb
                                        ? "Visitar el Sitio"
                                        : "Pregunta por el Servicio"}
                                </div>
                            </div>
                        </a>
                    </div>
                ))
            }
        </div>
    </div>
</section>
