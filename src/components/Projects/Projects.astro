---
import { projects } from "../../CONSTANTS";
import Gallery from "../atoms/Gallery.astro";

// export const prerender= true
---

<section id="projects" class="py-10 sm:py-12 md:py-15 place-items-center">
    <div class="max-w-240">
        <h2 class="sectionTitle">Proyectos de Clientes</h2>

        <p
            class="text-sm sm:text-base font-medium leading-5 sm:leading-6 text-text-primary"
        >
            Explora algunos de nuestro proyectos recientes y mira como podemos
            ayudarte a alcanzar tus metas con soluciones innovadoras.
        </p>

        <div
            class="grid gap-4 grid-cols-[repeat(auto-fit,minmax(210px,1fr))] place-items-center mt-6"
        >
            {
                projects.map((project) => (
                    <div class="bg-background-card border border-border rounded-lg p-4 flex flex-col gap-3 transition-all transform duration-300 ease-in-out hover:border-primary hover:-translate-y-1 animate-slide-in-top h-full group">
                        <div class="flex flex-col gap-1">
                            {/* <img
                                src={project.img}
                                alt={`${project.title} screenshot`}
                                class="w-full h-auto rounded-lg"
                            /> */}
                            <Gallery img={project.imgGallery} />
                            <a
                                class="pt-4 space-y-2"
                                href={project.url}
                                target={project.goToWeb ? "_blank" : "_self"}
                            >
                                <div class="space-y-2">
                                    <h4 class="text-base font-bold leading-5 text-text-primary">
                                        {project.title}
                                    </h4>
                                    <p class="text-sm font-medium leading-5 text-text-secondary">
                                        {project.description}
                                    </p>
                                </div>
                                <p class="text-primary text-xs group-hover:text-sm transition-all duration-300 ease-in-out font-bold">
                                    {`${project.goToWeb ? "Ver proyecto...":"Preguntar por el servicio"}`}
                                </p>
                            </a>
                        </div>
                    </div>
                ))
            }
        </div>
    </div>
</section>
