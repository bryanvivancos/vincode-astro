---
import { projects } from "../../CONSTANTS";
import GalleryReact from "../atoms/Gallery";

// export const prerender = true;
---

<section id="projects" class="w-full flex justify-center">
    <div class="section-container section-spacing">
        <p
            class="text-sm sm:text-base font-semibold tracking-wider text-primary uppercase mb-3"
        >
            Nuestro Trabajo
        </p>
        <h2 class="sectionTitle text-4xl md:text-5xl">Proyectos de Clientes</h2>

        <p
            class="text-base sm:text-lg font-medium leading-relaxed text-text-secondary max-w-3xl mb-10"
        >
            Explora algunos de nuestro proyectos recientes y mira como podemos
            ayudarte a alcanzar tus metas con soluciones innovadoras.
        </p>

        <div
            class="grid gap-5 sm:gap-6 grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4"
        >
            {
                projects.map((project) => (
                    <div
                        class="card-elegant flex flex-col gap-4 group
                    timeline-view animate-fade-in-up animate-range-[entry_10%_cover_40%]"
                    >
                        <div class="flex flex-col gap-3">
                            <div class="rounded-xl overflow-hidden">
                                <GalleryReact
                                    galleryID="landing-gallery"
                                    images={project.imgGallery}
                                    client:visible
                                />
                            </div>
                            <a
                                class="pt-2 space-y-3"
                                href={project.url}
                                target={project.goToWeb ? "_blank" : "_self"}
                            >
                                <div class="space-y-2">
                                    <h4 class="text-base font-bold leading-5 text-text-primary group-hover:text-primary transition-colors duration-300">
                                        {project.title}
                                    </h4>
                                    <p class="text-sm font-medium leading-relaxed text-text-secondary">
                                        {project.description}
                                    </p>
                                </div>
                                <p class="text-primary text-sm font-semibold group-hover:translate-x-1 transition-transform duration-300 inline-flex items-center gap-1">
                                    {`${project.goToWeb ? "Ver proyecto" : "Preguntar por el servicio"}`}
                                    <span class="text-lg">→</span>
                                </p>
                            </a>
                        </div>
                    </div>
                ))
            }
        </div>
    </div>
</section>
