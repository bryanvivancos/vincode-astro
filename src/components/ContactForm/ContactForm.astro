---
import toast from "react-hot-toast";
const FORM_ACCESS_KEY = import.meta.env.FORM_ACCESS_KEY;

const form = document.getElementById("contact-form");

 form?.addEventListener("submit", async (event) => {
    event.preventDefault();

    const form = event.currentTarget as HTMLFormElement;
    const formData = new FormData(form);

    formData.append("access_key", FORM_ACCESS_KEY);

    try {
        const response = await fetch("https://api.web3forms.com/submit", {
        method: "POST",
        body: formData,
        });

        const data: { success: boolean } = await response.json();
        // setResult(data.success ? "Success!" : "Error");
        // toast(data.success ? "Correo enviado" : "Error");
        if (data.success) {
        toast.success("Correo enviado satisfactoriamente", {
            position: 'bottom-right',
        });
        form.reset();
        }
    } catch (error) {
        console.error(error);
        toast.error("Error");
    }
  });
---

<section id="contact" class="py-10 sm:py-12 md:py-15 place-items-center">
    <div class="max-w-[960px] flex items-center flex-col w-full">
    <h2 class="sectionTitle text-center">Contáctanos</h2>

    <form class="flex flex-col gap-6 sm:gap-8 w-full md:max-w-lg"
       id="contact-form"
    >
    <!-- REQUIRED -->
    <input type="hidden" name="access_key" value={FORM_ACCESS_KEY} />

        <div class="flex flex-col gap-2">
        <label class="text-base font-normal text-text-primary">Nombre</label>
        <input
            type="text"
            id="name"
            name="name"
            placeholder="Tu nombre"
            class=" bg-input-background border-none rounded-lg py-4 px-5 text-base font-normal text-text-primary outline-none transition-all duration-300 ease-in-out placeholder:text-text-secondary focus:bg-[#2a4a56]"
            required
        />
        </div>

        <div class="flex flex-col gap-2">
        <label class="text-base font-normal text-text-primary">Correo</label>
        <input
            type="email"
            id="email"
            name="email"
            placeholder="Tu correo"
            class="bg-input-background border-none rounded-lg py-4 px-5 text-base font-normal text-text-primary outline-none transition-all duration-300 ease-in-out placeholder:text-text-secondary focus:bg-[#2a4a56]"
            required
        />
        </div>

        <div class="flex flex-col gap-2">
        <label class="text-base font-normal text-text-primary">Mensaje</label>
        <textarea
            id="message"
            name="message"
            placeholder="Deja tu mensaje..."
            class="bg-input-background border-none rounded-lg py-4 px-5 text-base font-normal text-text-primary outline-none transition-all duration-300 ease-in-out placeholder:text-text-secondary focus:bg-[#2a4a56] min-h-36 resize-y"
            required
        />
        </div>

        <button type="submit" class="self-center py-3 px-6 bg-primary rounded-lg text-sm font-bold text-text-primary transition-all duration-300 ease-in-out transform hover:bg-[#0090c7] hover:-translate-y-0.5">
        Enviar
        </button>
    </form>
    </div>
</section>