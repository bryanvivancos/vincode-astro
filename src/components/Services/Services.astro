---
import { SERVICES_SUBTITLE, SERVICES_TITLE } from "../../CONSTANTS";
import { icons, Share3Icon } from "../../components/icons";
import type { IconName } from "../../components/icons";
import { getCollection } from "astro:content";

const services = (await getCollection("services")).sort((a, b) => {
    if (a.data.available !== b.data.available) {
        return a.data.available ? -1 : 1;
    }
    return a.data.id - b.data.id;
});
---

<section id="services" data-scroll="services" class="section-alt">
    <div class="section-container section-spacing">
        <!-- Header -->
        <div class="text-center mb-16">
            <p class="eyebrow">Nuestros Servicios</p>
            <h2 class="sectionTitle mb-6">{SERVICES_TITLE}</h2>
            <p class="section-subtitle mx-auto">
                {SERVICES_SUBTITLE}
            </p>
        </div>

        <!-- Grid de servicios -->
        <div class="flex flex-col items-center">
            <div
                class="grid lg:grid-cols-4 md:grid-cols-2 grid-cols-1 gap-5 mb-8"
            >
                {
                    services.slice(0, 7).map((service, index) => {
                        const { slug, data } = service;
                        const { icon, title, cardDescription, available } =
                            data;
                        const Icon = icons?.[icon as IconName];

                        return (
                            <a
                                href={`/services/${slug}`}
                                class={`service-card flex flex-col gap-5 relative group fade-in-up ${available ? "" : "pointer-events-none"}`}
                            >
                                {/* Icono */}
                                <div class="w-12 h-12 rounded-xl bg-primary/10 flex items-center justify-center">
                                    {Icon ? (
                                        <Icon
                                            width={24}
                                            height={24}
                                            color="#00a8e8"
                                        />
                                    ) : (
                                        <span class="text-red-500 text-xs">
                                            ?
                                        </span>
                                    )}
                                </div>

                                {/* Contenido */}
                                <div class="flex flex-col gap-3 flex-1">
                                    <h4 class="text-lg font-bold text-text-primary group-hover:text-primary transition-colors duration-200">
                                        {title}
                                    </h4>
                                    <p class="text-sm font-normal leading-relaxed text-text-secondary">
                                        {cardDescription}
                                    </p>
                                </div>

                                {/* Link */}
                                <p class="text-sm font-semibold text-primary inline-flex items-center gap-1 group-hover:gap-2 transition-all duration-200">
                                    Más información <span>→</span>
                                </p>

                                {/* Badge Próximamente */}
                                {available === false && (
                                    <>
                                        <div class="badge badge-primary absolute -top-3 -right-3 z-50">
                                            Próximamente
                                        </div>
                                        <div class="absolute inset-0 bg-background-dark/70 z-40 rounded-2xl" />
                                    </>
                                )}
                            </a>
                        );
                    })
                }

                <!-- Card CTA -->
                <!-- <a
                href="/services"
                class="service-card flex flex-col gap-5 group fade-in-up"
            >
                <div
                    class="w-12 h-12 rounded-xl bg-primary/10 flex items-center justify-center"
                >
                    <Share3Icon width={24} height={24} color="#00a8e8" />
                </div>

                <div class="flex flex-col gap-3 flex-1">
                    <p
                        class="text-sm font-normal leading-relaxed text-text-secondary"
                    >
                        Ingresa para ver todos nuestros servicios disponibles.
                    </p>
                </div>

                <p
                    class="text-lg font-bold text-primary inline-flex items-center gap-1 group-hover:gap-2 transition-all duration-200"
                >
                    Más Servicios <span>→</span>
                </p>
            </a> -->
            </div>

            <a href={`/services`} class="btn-primary text-sm py-2.5 px-6">
                Más servicios
            </a>
        </div>
    </div>
</section>
