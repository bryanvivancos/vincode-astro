---
import { SERVICES_SUBTITLE, SERVICES_TITLE } from "../../CONSTANTS";
import { icons, Share3Icon } from "../../components/icons";
import type { IconName } from "../../components/icons";
import { getCollection } from "astro:content";

// const services = await getCollection('services')

const services = (await getCollection("services")).sort((a, b) => {
    // (a, b) => a.data.id - b.data.id
    // 1. Prioridad por disponibilidad (disponibles primero)
    // Convertimos booleanos a números para restar: true -> 1, false -> 0
    // Queremos que el 1 (disponible) vaya antes que el 0 (no disponible)
    if (a.data.available !== b.data.available) {
        return a.data.available ? -1 : 1;
    }

    // 2. Si ambos tienen la misma disponibilidad, ordenamos por ID
    return a.data.id - b.data.id;
});

// export const prerender= true
---

<section
    id="services"
    data-scroll="services"
    class="w-full flex justify-center"
>
    <div class="section-container section-spacing">
        <p
            class="text-sm sm:text-base font-semibold tracking-wider text-primary uppercase mb-3"
        >
            Nuestros Servicios
        </p>

        <div class="flex flex-col gap-8 sm:gap-10 md:gap-12">
            <div class="flex flex-col gap-3 sm:gap-4">
                <h2 class="sectionTitle text-4xl md:text-5xl">
                    {SERVICES_TITLE}
                </h2>
                <p
                    class="text-base sm:text-lg font-medium leading-relaxed text-text-secondary max-w-3xl"
                >
                    {SERVICES_SUBTITLE}
                </p>
            </div>

            <div
                class="grid lg:grid-cols-4 sm:grid-cols-2 grid-cols-1 gap-4 sm:gap-5"
            >
                {
                    services.slice(0, 7).map((service) => {
                        const { slug, data } = service;
                        const { icon, title, cardDescription, available } =
                            data;
                        const Icon = icons?.[icon as IconName];

                        return (
                            <a
                                href={`/services/${slug}`}
                                class={`card-elegant flex flex-col gap-4 relative group ${available ? "" : "pointer-events-none"} 
                                timeline-view animate-zoom-in animate-range-[entry_10%_cover_40%]`}
                            >
                                <div class="w-10 h-10 rounded-xl bg-primary/10 flex items-center justify-center group-hover:bg-primary/20 transition-colors duration-300">
                                    {Icon ? (
                                        <Icon
                                            width={22}
                                            height={22}
                                            color="#00a8e8"
                                        />
                                    ) : (
                                        <span class="text-red-500 text-xs">
                                            Icono no encontrado: {data.icon}
                                        </span>
                                    )}
                                </div>
                                <div class="flex flex-col gap-2">
                                    <h4 class="text-base font-bold leading-5 text-text-primary group-hover:text-primary transition-colors duration-300">
                                        {title}
                                    </h4>
                                    <p class="text-sm font-medium leading-relaxed text-text-secondary">
                                        {cardDescription}
                                    </p>
                                </div>

                                {available === false && (
                                    <>
                                        {/* Badge */}
                                        <div class="py-1 px-2.5 rounded-full absolute bg-primary -top-2 -right-2 z-50">
                                            <p class="text-[10px] font-bold uppercase tracking-wide">
                                                Próximamente
                                            </p>
                                        </div>

                                        {/* Overlay que sí bloquea clics */}
                                        <div class="absolute inset-0 bg-background-dark/60 z-40 rounded-xl" />
                                    </>
                                )}
                            </a>
                        );
                    })
                }

                <a
                    href={`/services`}
                    class={`card-elegant flex flex-col gap-4 group
                    timeline-view animate-zoom-in animate-range-[entry_10%_cover_40%]`}
                >
                    <div
                        class="w-10 h-10 rounded-xl bg-primary/10 flex items-center justify-center group-hover:bg-primary/20 transition-colors duration-300"
                    >
                        <Share3Icon width={22} height={22} color="#00a8e8" />
                    </div>

                    <div
                        class="flex flex-col justify-between gap-2 w-full flex-1"
                    >
                        <p
                            class="text-sm font-medium leading-relaxed text-text-secondary"
                        >
                            Ingresa para ver todos nuestros servicios
                            disponibles.
                        </p>
                        <h4
                            class="text-base font-bold leading-5 text-primary group-hover:translate-x-1 transition-transform duration-300 mt-2"
                        >
                            Más Servicios →
                        </h4>
                    </div>
                </a>
            </div>
        </div>
    </div>
</section>
