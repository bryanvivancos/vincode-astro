---
import { SERVICES_SUBTITLE, SERVICES_TITLE } from "../../CONSTANTS";
import { icons, Share3Icon } from "../../components/icons";
import type { IconName } from "../../components/icons";
import { getCollection } from "astro:content";

// const services = await getCollection('services')

const services = (await getCollection("services")).sort(
    (a, b) => a.data.id - b.data.id
);

// export const prerender= true
---

<section
    id="services"
    data-scroll="services"
    class="w-full flex justify-center"
>
    <div class="max-w-240 py-10 sm:py-12 md:py-15">
        <h2
            class="text-lg sm:text-xl font-bold leading-6 sm:leading-7 text-text-primary mb-6 sm:mb-8 md:mb-10"
        >
            Nuestros Servicios
        </h2>

        <div class="flex flex-col gap-6 sm:gap-8 md:gap-10">
            <div class="flex flex-col gap-2 sm:gap-3">
                <h3 class="sectionTitle">{SERVICES_TITLE}</h3>
                <p
                    class="text-sm sm:text-base font-medium leading-5 sm:leading-6 text-text-primary"
                >
                    {SERVICES_SUBTITLE}
                </p>
            </div>

            <div
                class="grid lg:grid-cols-4 sm:grid-cols-2 grid-cols-1 gap-2 sm:gap-4"
            >
                {
                    services.slice(0, 7).map((service) => {
                        const { slug, data } = service;
                        const { icon, title, cardDescription, available } =
                            data;
                        const Icon = icons?.[icon as IconName];

                        return (
                            <a
                                href={`/services/${slug}`}
                                class={`bg-background-card  border-border rounded-lg p-4 flex flex-col gap-3 transition-all transform duration-300 ease-in-out relative ${available ? "hover:border-primary hover:-translate-y-1 border" : "pointer-events-none"}`}
                            >
                                {Icon ? (
                                    <Icon
                                        width={24}
                                        height={24}
                                        color="#FFFFFF"
                                    />
                                ) : (
                                    <span class="text-red-500 text-xs">
                                        Icono no encontrado: {data.icon}
                                    </span>
                                )}
                                <div class="flex flex-col gap-1">
                                    <h4
                                        class="text-base font-bold leading-5 text-text-primary"
                                        transition:name={`service-${title}`}
                                    >
                                        {title}
                                    </h4>
                                    <p class="text-sm font-medium leading-5 text-text-secondary">
                                        {cardDescription}
                                    </p>
                                </div>

                                {available === false && (
                                    <>
                                        {/* Badge */}
                                        <div class="p-1.5 rounded-lg absolute bg-[#0090c7] -top-1 -right-1 z-50">
                                            <p class="text-xs font-semibold">
                                                PROXIMAMENTE
                                            </p>
                                        </div>

                                        {/* Overlay que sí bloquea clics */}
                                        <div class="absolute top-0 left-0 w-full h-full bg-black/50 bg-opacity-50 z-40 rounded-lg" />
                                    </>
                                )}
                            </a>
                        );
                    })
                }

                <a
                    href={`/services`}
                    class={`bg-background-card  border-border rounded-lg p-4 flex flex-col gap-3 transition-all transform duration-300 ease-in-out relative hover:border-primary hover:-translate-y-1 border`}
                >
                    <Share3Icon width={24} height={24} color="#FFFFFF" />

                    <div class="flex flex-col gap-1 relative w-full flex-1">
                        <h4
                            class="text-base font-bold leading-5 text-primary absolute bottom-0"
                        >
                            Más Servicios...
                        </h4>
                        <p
                            class="text-sm font-medium leading-5 text-text-secondary"
                        >
                            Ingresa para ver todos nuestros servicios
                            disponibles.
                        </p>
                    </div>
                </a>
            </div>
        </div>
    </div>
</section>
