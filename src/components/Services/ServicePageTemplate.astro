---
import GalleryReact from "../atoms/Gallery";
// import Gallery from "../atoms/Gallery.astro";
import { SlideItems } from "../atoms/SlideItems";
import { FAQAccordion, type FaqData } from "../FAQAccordion/FAQAccordion";
import { type IconName } from "../icons";

type Profits = {
    icon: IconName;
    id: number;
    title: string;
    description: string;
};

type Project = {
    title: string;
    description: string;
    img?: string;
    imgGallery: Array<string>;
};

interface ServicesPageProps {
    serviceTitle: string;
    subtitles: string;
    description: string;
    demos: string;
    profits: Profits[];
    projects: Project[];
    faqsItems: FaqData[];
}

const {
    serviceTitle,
    description,
    subtitles,
    profits,
    projects,
    faqsItems,
    demos,
} = Astro.props as ServicesPageProps;

// export const prerender= true
---

<section class="mt-16 py-9 max-w-240 px-4 space-y-8">
    <!-- <a
        href="/services"
        class="text-slate-400 hover:text-slate-300 transition-all ease-in-out duration-300 flex items-center gap-4"
        ><ChevronLeftIcon width={20} height={20} />
        <span>Ir a Servicios</span>
    </a> -->
    <h1
        class="text-base md:text-xl font-bold leading-15 md:leading-13 -tracking-[0.5px] text-text-primary"
    >
        {serviceTitle}
    </h1>

    <p class="text-sm md:text-base font-medium leading-5 text-text-secondary">
        {subtitles}
    </p>

    <p class="text-base md:text-lg font-medium leading-6 text-text-primary">
        {description}
    </p>

    <div
        class={`${profits.length == 4 ? "lg:grid-cols-2" : "lg:grid-cols-3"} grid gap-2 sm:grid-cols-1 grid-cols-1`}
    >
        {
            profits.map((profit) => (
                <SlideItems
                    icon={profit.icon}
                    title={profit.title}
                    description={profit.description}
                    classNames="cursor-default animate-slide-in-top"
                />
            ))
        }
    </div>

    <h3 class="text-xl md:text-2xl -mb-1 font-bold text-center">{demos}</h3>
    {
        projects.map(
            (project) =>
                project.img && (
                    <>
                        <div class="flex gap-4 items-center justify-center">
                            <div class="p-4 flex flex-col gap-3 transition-all transform duration-300 ease-in-out hover:border-primary hover:-translate-y-1">
                                <div class="flex flex-col gap-1">
                                    {/* <img
                                        src={project.img}
                                        alt="project image"
                                        class="w-full h-auto rounded-lg"
                                    /> */}
                                    <GalleryReact
                                        galleryID="landing-gallery"
                                        images={project.imgGallery}
                                        client:visible
                                    />
                                    <div class="pt-4 space-y-3">
                                        <h4 class="text-lg font-bold leading-5 text-text-primary text-balance">
                                            {project.title}
                                        </h4>
                                        <p class="text-base font-medium leading-5 text-text-secondary">
                                            {project.description}
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </>
                ),
        )
    }

    <h3 class="text-2xl md:text-3xl font-bold">Preguntas Frecuentes</h3>

    <FAQAccordion faqs={faqsItems} />

    <div class="flex justify-center">
        <a href="/contact" class="btn-primary">Solicitar Cotización</a>
    </div>
</section>
