---
import GalleryReact from "../atoms/Gallery";
import { FAQAccordion, type FaqData } from "../FAQAccordion/FAQAccordion";
import { icons, type IconName } from "../icons";
import PricingSection from "../Pricing/PricingSection.astro";
import Breadcrumbs from "../Breadcrumbs/Breadcrumbs.astro";
import {
    PortfolioIllustration,
    DigitalCardIllustration,
    LinkBioIllustration,
    CustomSoftwareIllustration,
    VinDisplayIllustration,
    EcommerceIllustration,
    TechniqueSupportIllustration,
    PointOfServiceIllustration,
    VinRestIllustration,
    LandingPageIllustration,
} from "./ServiceHeroIllustrations";

type Profits = {
    icon: IconName;
    id: number;
    title: string;
    description: string;
};

type Project = {
    title: string;
    description: string;
    img?: string;
    imgGallery: Array<string>;
};

type PricingPackage = {
    id: number;
    name: string;
    description: string;
    price: number;
    originalPrice: number;
    discount: string;
    deliveryTime?: string;
    isPopular?: boolean;
    includes: string[];
    finalNote?: string;
    color?: "gray" | "primary" | "teal" | "purple" | "green";
};

interface ServicesPageProps {
    serviceTitle: string;
    subtitles: string;
    description: string;
    demos: string;
    profits: Profits[];
    projects: Project[];
    faqsItems: FaqData[];
    heroImage?: string;
    serviceSlug?: string;
    pricing?: PricingPackage[];
}

const {
    serviceTitle,
    description,
    subtitles,
    profits,
    projects,
    faqsItems,
    demos,
    heroImage,
    serviceSlug,
    pricing = [],
} = Astro.props as ServicesPageProps;

const illustrationMap: Record<string, any> = {
    portfolio: PortfolioIllustration,
    "digital-card": DigitalCardIllustration,
    "link-bio": LinkBioIllustration,
    "custom-software": CustomSoftwareIllustration,
    "vin-display": VinDisplayIllustration,
    ecommerce: EcommerceIllustration,
    "technique-support": TechniqueSupportIllustration,
    "point-of-service": PointOfServiceIllustration,
    "vin-rest": VinRestIllustration,
    "landing-page": LandingPageIllustration,

    "diseño-portafolio-profesional": PortfolioIllustration,
    "diseño-tarjeta-de-presentacion": DigitalCardIllustration,
    "desarrollo-links-bio": LinkBioIllustration,
    "desarrollo-software-a-medida": CustomSoftwareIllustration,
    "sistema-carteleria-digital": VinDisplayIllustration,
    "creación-paginas-web-ecommerce": EcommerceIllustration,
    "software-licenciado": TechniqueSupportIllustration,
    "punto-de-venta": PointOfServiceIllustration,
    "sistema-para-restaurante": VinRestIllustration,
    "desarrollo-pagina-web": LandingPageIllustration,
};

const IllustrationComponent = serviceSlug ? illustrationMap[serviceSlug] : null;

const breadcrumbItems = [
    { label: "Inicio", href: "/" },
    { label: "Servicios", href: "/servicios" },
    { label: serviceTitle, href: "#" },
];
---

<!-- Hero Section -->
<section
    class="bg-gradient-to-br from-gray-50 to-white pt-28 pb-20 md:pt-32 md:pb-28"
>
    <div class="section-container">
        <Breadcrumbs items={breadcrumbItems} />
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
            <!-- Contenido izquierda -->
            <div class="space-y-6">
                <h2
                    class="text-xs md:text-sm font-semibold tracking-widest text-primary uppercase"
                >
                    {subtitles}
                </h2>

                <h1
                    class="!text-4xl md:!text-5xl font-black text-text-primary leading-tight"
                >
                    {serviceTitle}
                </h1>

                <h2
                    class="text-sm md:text-base text-text-secondary leading-relaxed"
                >
                    {description}
                </h2>

                <div class="flex flex-col sm:flex-row gap-4 pt-4">
                    <a
                        href="/contact"
                        class="inline-flex items-center justify-center gap-2 px-8 py-4 bg-primary text-white font-semibold rounded-full transition-all duration-200 hover:bg-primary-hover hover:scale-105 hover:shadow-xl"
                    >
                        Solicitar una reunión
                        <!-- <svg
                            class="w-5 h-5"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
                        </svg> -->
                    </a>
                    <a
                        href="#pricing"
                        class="inline-flex items-center justify-center gap-2 px-8 py-4 border-2 border-gray-200 text-text-primary font-semibold rounded-full transition-all duration-200 hover:border-primary hover:text-primary"
                    >
                        Ver Precios
                    </a>
                </div>
            </div>

            <!-- Ilustración del servicio -->
            <div class="hidden lg:flex items-center justify-center">
                <div class="w-full max-w-lg">
                    {
                        heroImage && (
                            <img
                                src={heroImage}
                                alt={serviceTitle}
                                class="w-full h-auto"
                            />
                        )
                    }
                    {
                        !heroImage && IllustrationComponent && (
                            <IllustrationComponent />
                        )
                    }
                    {
                        !heroImage && !IllustrationComponent && (
                            <div class="space-y-4">
                                <div class="w-16 h-16 bg-primary/10 rounded-xl flex items-center justify-center">
                                    <svg
                                        class="w-8 h-8 text-primary"
                                        fill="none"
                                        stroke="currentColor"
                                        viewBox="0 0 24 24"
                                    >
                                        <path
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            stroke-width="2"
                                            d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"
                                        />
                                    </svg>
                                </div>
                                <div class="space-y-2">
                                    <div class="h-4 bg-gray-200 rounded w-3/4" />
                                    <div class="h-3 bg-gray-100 rounded w-full" />
                                    <div class="h-3 bg-gray-100 rounded w-5/6" />
                                </div>
                            </div>
                        )
                    }
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Sección: Nuestro Enfoque / Beneficios -->
<section class="py-4 md:py-14 bg-[#f8f8fa]">
    <div class="section-container">
        <div class="text-center max-w-3xl mx-auto mb-12">
            <p
                class="text-xs md:text-sm font-semibold tracking-widest text-primary uppercase mb-4"
            >
                Nuestro Enfoque
            </p>
            <p class="!text-2xl md:!text-3xl font-bold text-text-primary mb-6">
                Cómo Transformamos Tu Visión en Realidad
            </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-12">
            {
                profits.map((profit) => {
                    const IconComponent = icons[profit.icon];
                    return (
                        <div class="bg-[#fafcff] rounded-2xl p-8 hover:shadow-lg transition-all duration-200">
                            <div class="flex items-start gap-4">
                                <div class="w-12 h-12 bg-primary/10 rounded-xl flex items-center justify-center flex-shrink-0">
                                    {IconComponent && (
                                        <IconComponent
                                            width={24}
                                            height={24}
                                            color="#00a8e8"
                                        />
                                    )}
                                </div>
                                <div class="space-y-2">
                                    <h3 class="text-xl font-bold text-text-primary">
                                        {profit.title}
                                    </h3>
                                    <p class="text-base text-text-secondary leading-relaxed">
                                        {profit.description}
                                    </p>
                                </div>
                            </div>
                        </div>
                    );
                })
            }
        </div>
    </div>
</section>

{
    pricing && pricing.length > 0 && (
        <PricingSection packages={pricing} serviceName={serviceTitle} />
    )
}

<!-- Sección: Ejemplos / Demos -->
{
    projects.length > 0 && (
        <section class="py-20 md:py-24 bg-gray-50">
            <div class="section-container">
                <div class="text-center max-w-3xl mx-auto mb-16">
                    <h2 class="text-3xl md:text-4xl font-bold text-text-primary mb-4">
                        {demos}
                    </h2>
                </div>

                <div class="space-y-16">
                    {projects.map(
                        (project, index) =>
                            project.img && (
                                <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
                                    <div
                                        class={
                                            index % 2 === 0
                                                ? "order-1"
                                                : "order-1 lg:order-2"
                                        }
                                    >
                                        <div class="bg-[#f8f8fa] rounded-2xl p-6 shadow-lg">
                                            <GalleryReact
                                                galleryID={`demo-${index}`}
                                                images={project.imgGallery}
                                                client:visible
                                            />
                                        </div>
                                    </div>
                                    <div
                                        class={
                                            index % 2 === 0
                                                ? "order-2"
                                                : "order-2 lg:order-1"
                                        }
                                    >
                                        <div class="space-y-4">
                                            <h3 class="text-2xl md:text-3xl font-bold text-text-primary">
                                                {project.title}
                                            </h3>
                                            <p class="text-sm md:text-xl text-gray-500 max-w-2xl leading-relaxed">
                                                {project.description}
                                            </p>
                                        </div>
                                    </div>
                                </div>
                            ),
                    )}
                </div>
            </div>
        </section>
    )
}

<!-- Sección: FAQs -->
<section class="py-20 md:py-24 bg-gray-50">
    <div class="section-container max-w-4xl">
        <div class="text-center mb-16">
            <h2
                class="text-3xl md:text-4xl font-bold text-text-primary leading-tight"
            >
                Tus Preguntas,<br />Respondidas
            </h2>
        </div>

        <div class="space-y-4">
            {
                faqsItems.map((faq) => (
                    <details class="group bg-[#f8f8fa] rounded-2xl border border-gray-200 p-6 hover:shadow-md transition-all duration-200">
                        <summary class="flex items-center justify-between cursor-pointer list-none">
                            <h3 class="text-base font-semibold text-text-primary pr-4">
                                {faq.question}
                            </h3>
                            <span class="flex-shrink-0 w-8 h-8 flex items-center justify-center rounded-full bg-gray-100 group-open:bg-primary group-open:text-white transition-colors duration-200">
                                <svg
                                    class="w-5 h-5 group-open:rotate-45 transition-transform duration-200"
                                    fill="none"
                                    stroke="currentColor"
                                    viewBox="0 0 24 24"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="2"
                                        d="M12 4v16m8-8H4"
                                    />
                                </svg>
                            </span>
                        </summary>
                        <div class="mt-4 pt-4 border-t border-gray-100">
                            <p class="text-sm text-text-secondary leading-relaxed">
                                {faq.answer}
                            </p>
                        </div>
                    </details>
                ))
            }
        </div>
    </div>
</section>

<!-- CTA Final -->
<section class="py-16 md:py-20 bg-gray-50">
    <div class="section-container text-center">
        <h2 class="text-3xl md:text-4xl font-bold text-text-primary mb-6">
            ¿Listo para Empezar tu Proyecto?
        </h2>
        <p
            class="text-base md:text-lg text-text-secondary mb-8 max-w-2xl mx-auto"
        >
            Contáctanos hoy y descubre cómo podemos ayudarte a alcanzar tus
            objetivos digitales.
        </p>
        <a
            href="/contact"
            class="inline-flex items-center gap-2 px-10 py-5 bg-primary text-white font-semibold rounded-full text-lg transition-all duration-200 hover:bg-primary-hover hover:scale-105 hover:shadow-xl"
        >
            Solicitar Cotización
            <svg
                class="w-5 h-5"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
            >
                <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
            </svg>
        </a>
    </div>
</section>
