---
interface Service {
    slug: string;
    data: {
        icon: string;
        category: string;
        title: string;
        cardDescription: string;
        available?: boolean;
    };
}

interface Props {
    services: Service[];
    itemCategory: string;
    icons: Record<string, any>;
}

const { services, icons, itemCategory } = Astro.props;
type IconName = keyof typeof icons;
---

<div
    class="grid lg:grid-cols-4 sm:grid-cols-2 grid-cols-1 gap-4 sm:gap-5 mb-10"
>
    {
        services.map((service) => {
            const { slug, data } = service;
            const { icon, category, title, cardDescription, available } = data;
            const Icon = icons?.[icon as IconName];

            if (category === itemCategory) {
                return (
                    <a
                        href={`/services/${slug}`}
                        class={`card-elegant flex flex-col gap-4 relative group 
                        timeline-view animate-fade-in-up animate-range-[entry_10%_cover_40%]
                        ${available ? "" : "pointer-events-none"}`}
                    >
                        <div class="w-10 h-10 rounded-xl bg-primary/10 flex items-center justify-center group-hover:bg-primary/20 transition-colors duration-300">
                            {Icon ? (
                                <Icon width={22} height={22} color="#00a8e8" />
                            ) : (
                                <span class="text-red-500 text-xs">
                                    Icono no encontrado: {data.icon}
                                </span>
                            )}
                        </div>
                        <div class="flex flex-col justify-between gap-2 flex-1">
                            <div class="space-y-2">
                                <h4 class="text-base font-bold leading-5 text-text-primary group-hover:text-primary transition-colors duration-300">
                                    {title}
                                </h4>
                                <p class="text-sm font-medium leading-relaxed text-text-secondary">
                                    {cardDescription}
                                </p>
                            </div>

                            {available && (
                                <p class="text-primary text-sm font-semibold group-hover:translate-x-1 transition-transform duration-300 inline-flex items-center gap-1 mt-2">
                                    Más información{" "}
                                    <span class="text-lg">→</span>
                                </p>
                            )}
                        </div>

                        {available === false && (
                            <>
                                {/* Badge */}
                                <div class="py-1 px-2.5 rounded-full absolute bg-primary -top-2 -right-2 z-50">
                                    <p class="text-[10px] font-bold uppercase tracking-wide">
                                        Próximamente
                                    </p>
                                </div>

                                {/* Overlay que sí bloquea clics */}
                                <div class="absolute inset-0 bg-background-dark/60 z-40 rounded-xl" />
                            </>
                        )}
                    </a>
                );
            }
        })
    }
</div>
