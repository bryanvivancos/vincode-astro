---
interface Service {
    slug: string;
    data: {
        icon: string;
        category: string;
        title: string;
        cardDescription: string;
        available?: boolean;
    };
}

interface Props {
    services: Service[];
    itemCategory: string;
    icons: Record<string, any>;
}

const { services, icons, itemCategory } = Astro.props;
type IconName = keyof typeof icons;
---

<div class="grid lg:grid-cols-4 md:grid-cols-2 grid-cols-1 gap-5">
    {
        services.map((service, index) => {
            const { slug, data } = service;
            const { icon, category, title, cardDescription, available } = data;
            const Icon = icons?.[icon as IconName];

            if (category === itemCategory) {
                return (
                    <a
                        href={`/services/${slug}`}
                        class={`service-card flex flex-col gap-5 relative group fade-in-up ${available ? "" : "pointer-events-none"}`}
                    >
                        <div class="w-12 h-12 rounded-xl bg-primary/10 flex items-center justify-center">
                            {Icon ? (
                                <Icon width={24} height={24} color="#00a8e8" />
                            ) : (
                                <span class="text-red-500 text-xs">?</span>
                            )}
                        </div>

                        <div class="flex flex-col gap-3 flex-1">
                            <h4 class="text-lg font-bold text-text-primary group-hover:text-primary transition-colors duration-200">
                                {title}
                            </h4>
                            <p class="text-sm font-normal leading-relaxed text-text-secondary">
                                {cardDescription}
                            </p>
                        </div>

                        {available && (
                            <p class="text-sm font-semibold text-primary inline-flex items-center gap-1 group-hover:gap-2 transition-all duration-200">
                                Más información <span>→</span>
                            </p>
                        )}

                        {available === false && (
                            <>
                                <div class="badge badge-primary absolute -top-3 -right-3 z-50">
                                    Próximamente
                                </div>
                                <div class="absolute inset-0 bg-background-dark/70 z-40 rounded-2xl" />
                            </>
                        )}
                    </a>
                );
            }
        })
    }
</div>
