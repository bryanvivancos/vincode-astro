---
interface Service {
    slug: string;
    data: {
        icon: string;
        category: string;
        title: string;
        cardDescription: string;
        available?: boolean;
    };
}

interface Props {
    services: Service[];
    itemCategory: string;
    icons: Record<string, any>;
}

const { services, icons, itemCategory } = Astro.props;
type IconName = keyof typeof icons;
---

<div class="grid md:grid-cols-2 grid-cols-1 gap-8 lg:gap-10">
    {
        services.map((service, index) => {
            const { slug, data } = service;
            const { icon, category, title, cardDescription, available } = data;
            const Icon = icons?.[icon as IconName];

            if (category === itemCategory) {
                return (
                    <div
                        class={`bg-[#f8f8fa] rounded-2xl border border-gray-200 p-6 py-8 md:p-12 shadow-card-mobile md:shadow-md hover:shadow-card-hover-xl transition-all duration-200 relative group fade-in-up ${!available ? "opacity-60" : ""}`}
                    >
                        {/* Icono */}
                        <div class="mb-6">
                            <div class="w-14 h-14 rounded-full bg-primary/10 flex items-center justify-center">
                                {Icon ? (
                                    <Icon
                                        width={28}
                                        height={28}
                                        color="#00a8e8"
                                    />
                                ) : (
                                    <span class="text-red-500 text-xs">?</span>
                                )}
                            </div>
                        </div>

                        {/* Título */}
                        <h3 class="text-2xl md:text-3xl font-bold text-text-primary mb-4 leading-tight">
                            {title}
                        </h3>

                        {/* Descripción */}
                        <p class="text-base md:text-lg font-normal leading-relaxed text-text-secondary mb-6">
                            {cardDescription}
                        </p>

                        {/* Botón de acción */}
                        <a
                            href={`/servicios/${slug}`}
                            class={`inline-flex items-center gap-2 px-6 py-3 bg-gray-50 border border-gray-200 rounded-full text-sm font-semibold text-text-primary transition-all duration-200 hover:bg-primary hover:text-white hover:border-primary ${!available ? "pointer-events-none opacity-30" : ""}`}
                        >
                            Ver detalles
                            <svg
                                class="w-4 h-4"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M17 8l4 4m0 0l-4 4m4-4H3"
                                />
                            </svg>
                        </a>

                        {/* Badge próximamente */}
                        {!available && (
                            <div class="absolute top-6 right-6 px-3 py-1.5 rounded-full bg-[#f8f8fa]/90 backdrop-blur-sm border border-gray-200">
                                <span class="text-xs font-semibold text-gray-600 uppercase tracking-wider">
                                    Próximamente
                                </span>
                            </div>
                        )}
                    </div>
                );
            }
        })
    }
</div>
