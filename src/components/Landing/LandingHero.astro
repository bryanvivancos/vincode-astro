---
import { LANDING_HERO, LANDING_VINBOOK_STRIP } from "../../data/landing";
import VinbookHeroMockup from "./VinbookHeroMockup";
---

<div class="hero-flow">
    <!-- Hero principal VINCODE (estático) -->
    <section
        id="hero"
        class="relative min-h-[85dvh] overflow-hidden md:min-h-[92dvh]"
        aria-labelledby="hero-heading"
    >
        <div class="pointer-events-none absolute inset-0" aria-hidden="true">
            <img
                src="https://images.unsplash.com/photo-1517694712202-14dd9538aa97?w=1920&h=1080&fit=crop&q=80"
                alt=""
                class="h-full w-full object-cover"
                loading="eager"
                fetchpriority="high"
                decoding="async"
                width="1920"
                height="1080"
            />
            <div
                class="absolute inset-0 bg-gradient-to-b from-black/75 via-black/70 to-black/85 md:bg-gradient-to-r md:from-black/85 md:via-black/65 md:to-black/35"
            >
            </div>
            <div class="absolute inset-0 bg-gradient-to-t from-black/50 via-transparent to-black/30">
            </div>
        </div>

        <div
            class="section-container relative z-10 flex min-h-[85dvh] w-full items-center pt-24 pb-20 sm:pt-28 sm:pb-24 md:min-h-[92dvh] md:pt-36 md:pb-28"
        >
            <div class="grid min-w-0 w-full grid-cols-1 items-center gap-8 lg:grid-cols-2 lg:gap-16">
                <div class="min-w-0">
                    <p class="eyebrow mb-3 text-primary">{LANDING_HERO.eyebrow}</p>
                    <h1
                        id="hero-heading"
                        class="mb-4 max-w-2xl text-[clamp(1.75rem,6vw,3.75rem)] font-semibold leading-[1.12] tracking-tight text-white [overflow-wrap:anywhere] md:mb-6"
                    >
                        {LANDING_HERO.title}
                    </h1>
                    <p
                        class="mb-7 max-w-xl text-sm leading-relaxed text-gray-200 sm:text-base md:mb-10 md:text-lg"
                    >
                        {LANDING_HERO.subtitle}
                    </p>
                    <div class="flex flex-col gap-3 sm:flex-row sm:items-center">
                        <a
                            href={LANDING_HERO.primaryCta.href}
                            class="btn-primary w-full text-center sm:w-auto"
                        >
                            {LANDING_HERO.primaryCta.label}
                        </a>
                        <a
                            href={LANDING_HERO.secondaryCta.href}
                            class="inline-flex w-full items-center justify-center rounded-full border border-white/30 bg-white/5 px-7 py-3 text-base font-semibold text-white backdrop-blur-sm transition-all duration-200 hover:border-white hover:bg-white/10 sm:w-auto"
                        >
                            {LANDING_HERO.secondaryCta.label}
                        </a>
                    </div>
                </div>

                <!-- Visual abstracto VINCODE -->
                <div
                    class="relative mx-auto hidden w-full max-w-lg md:block lg:max-w-none"
                    aria-hidden="true"
                >
                    <div
                        class="relative aspect-square max-h-[420px] w-full overflow-hidden rounded-3xl border border-white/20 bg-background-card/95 p-6 shadow-2xl backdrop-blur-sm md:p-8"
                    >
                        <div
                            class="absolute inset-0 bg-[linear-gradient(135deg,rgba(0,168,232,0.06)_0%,transparent_50%)]"
                        >
                        </div>
                        <div class="relative grid h-full grid-cols-2 grid-rows-2 gap-3 md:gap-4">
                            <div
                                class="landing-float flex h-full min-h-0 flex-col rounded-2xl border border-border bg-white p-4 shadow-sm"
                            >
                                <div class="mb-3 h-2 w-8 shrink-0 rounded-full bg-primary/30">
                                </div>
                                <div class="space-y-2">
                                    <div class="h-2 w-full rounded bg-border"></div>
                                    <div class="h-2 w-4/5 rounded bg-border"></div>
                                </div>
                                <p class="mt-auto pt-4 text-xs font-semibold text-primary">
                                    Web
                                </p>
                            </div>
                            <div
                                class="landing-float flex h-full min-h-0 flex-col rounded-2xl border border-primary/20 bg-primary-light p-4 shadow-sm"
                                style="animation-delay: 200ms"
                            >
                                <div class="mb-3 flex shrink-0 gap-1">
                                    <span class="size-2 rounded-full bg-primary/40"></span>
                                    <span class="size-2 rounded-full bg-primary/25"></span>
                                </div>
                                <div class="h-16 shrink-0 rounded-xl bg-primary/10"></div>
                                <p class="mt-auto pt-4 text-xs font-semibold text-primary">
                                    Reservas
                                </p>
                            </div>
                            <div
                                class="landing-float flex h-full min-h-0 flex-col rounded-2xl border border-border bg-white p-4 shadow-sm"
                                style="animation-delay: 400ms"
                            >
                                <div class="grid grid-cols-3 gap-1.5">
                                    {
                                        Array.from({ length: 6 }).map(() => (
                                            <div class="h-8 rounded-md bg-border/60 md:h-9" />
                                        ))
                                    }
                                </div>
                                <p class="mt-auto pt-4 text-xs font-semibold text-primary">
                                    Dashboard
                                </p>
                            </div>
                            <div
                                class="landing-float flex h-full min-h-0 flex-col rounded-2xl border border-border bg-white p-4 shadow-sm"
                                style="animation-delay: 600ms"
                            >
                                <div class="flex h-14 shrink-0 items-end gap-1">
                                    <div class="h-6 w-3 rounded-t bg-primary/30"></div>
                                    <div class="h-10 w-3 rounded-t bg-primary/50"></div>
                                    <div class="h-14 w-3 rounded-t bg-primary"></div>
                                    <div class="h-8 w-3 rounded-t bg-primary/40"></div>
                                </div>
                                <p class="mt-auto pt-4 text-xs font-semibold text-primary">
                                    Automatización
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Bloque promocional VINBOOK (estático) -->
    <section
        id="vinbook"
        class="relative overflow-x-clip border-t border-white/10 bg-[#0a1620]"
        aria-labelledby="vinbook-strip-heading"
    >
        <div
            class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_70%_80%_at_85%_50%,rgba(0,168,232,0.12),transparent)]"
            aria-hidden="true"
        >
        </div>
        <div class="section-container relative z-10 py-10 md:py-14">
            <div
                class="grid min-w-0 grid-cols-1 items-center gap-8 md:grid-cols-2 md:gap-10 lg:gap-14"
            >
                <div class="min-w-0 text-center md:text-left">
                    <p class="eyebrow mb-3 text-primary">
                        {LANDING_VINBOOK_STRIP.eyebrow}
                    </p>
                    <h2
                        id="vinbook-strip-heading"
                        class="mb-3 max-w-lg text-[clamp(1.35rem,3.5vw,2rem)] font-semibold leading-snug tracking-tight text-white [overflow-wrap:anywhere] md:mx-0 mx-auto"
                    >
                        {LANDING_VINBOOK_STRIP.title}
                    </h2>
                    <p
                        class="mb-6 max-w-md text-sm leading-relaxed text-gray-300 sm:text-base md:mx-0 mx-auto"
                    >
                        {LANDING_VINBOOK_STRIP.subtitle}
                    </p>
                    <a
                        href={LANDING_VINBOOK_STRIP.cta.href}
                        class="btn-primary inline-flex w-full items-center justify-center sm:w-auto"
                    >
                        {LANDING_VINBOOK_STRIP.cta.label}
                    </a>
                </div>
                <div class="min-w-0 flex justify-center md:justify-end">
                    <VinbookHeroMockup compact />
                </div>
            </div>
        </div>
    </section>
</div>
