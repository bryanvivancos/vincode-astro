---
import { LANDING_SOLUTIONS } from "../../data/landing";
---

<section id="soluciones" class="section-alt" aria-labelledby="solutions-heading">
    <div class="section-container section-spacing">
        <div class="fade-in-up mb-10 max-w-3xl md:mb-16 lg:mb-20">
            <p class="eyebrow">Capacidades</p>
            <h2 id="solutions-heading" class="sectionTitle mb-4 md:mb-6">
                Tres formas de construir tu solución
            </h2>
            <p class="section-subtitle text-sm md:text-base lg:text-lg">
                Algunos negocios necesitan una mejor web. Otros necesitan software
                que no existe en el mercado. Diseñamos y construimos ambos.
            </p>
        </div>

        <div class="grid min-w-0 grid-cols-1 gap-4 sm:gap-6 md:grid-cols-2 lg:grid-cols-3 lg:gap-10">
            {
                LANDING_SOLUTIONS.map((solution, index) => (
                    <article
                        class={`fade-in-up stagger-${Math.min(index + 1, 8)} group flex min-w-0 flex-col rounded-2xl border border-border bg-background-card p-5 transition-all duration-200 hover:-translate-y-1 hover:border-primary/30 hover:shadow-lg sm:p-6 md:p-8 lg:p-10`}
                    >
                        <div class="mb-3 flex items-baseline gap-3 md:mb-6 md:flex-col md:gap-0">
                            <span class="font-Codesaver text-sm font-bold tracking-wider text-primary">
                                {solution.number}
                            </span>
                            <h3 class="text-lg font-bold text-text-primary md:mt-4 md:text-xl lg:text-2xl">
                                {solution.title}
                            </h3>
                        </div>
                        <p class="mb-4 flex-1 text-sm leading-relaxed text-text-secondary md:mb-8 md:text-base">
                            {solution.description}
                        </p>
                        <ul
                            class="flex flex-wrap gap-2 border-t border-border pt-4 md:block md:space-y-2 md:pt-6"
                            role="list"
                        >
                            {solution.items.map((item) => (
                                <li class="flex items-center gap-1.5 rounded-full border border-border bg-background-dark px-2.5 py-1 text-xs text-text-secondary md:rounded-none md:border-0 md:bg-transparent md:px-0 md:py-0 md:text-sm">
                                    <span
                                        class="hidden size-1.5 shrink-0 rounded-full bg-primary md:inline-block"
                                        aria-hidden="true"
                                    />
                                    {item}
                                </li>
                            ))}
                        </ul>
                    </article>
                ))
            }
        </div>
    </div>
</section>
