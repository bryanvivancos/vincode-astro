---
import { LANDING_PROCESS } from "../../data/landing";
---

<section id="proceso" aria-labelledby="process-heading">
    <div class="section-container section-spacing">
        <div class="fade-in-up mb-16 md:mb-24">
            <p class="eyebrow">Proceso</p>
            <h2 id="process-heading" class="sectionTitle mb-6">
                De la idea al lanzamiento
            </h2>
            <p class="section-subtitle max-w-2xl">
                Un proceso claro para que sepas qué esperar en cada etapa.
            </p>
        </div>

        <div class="grid min-w-0 grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-4 lg:gap-10">
            {
                LANDING_PROCESS.map((step, index) => (
                    <article
                        class={`fade-in-up stagger-${Math.min(index + 1, 8)} relative min-w-0 rounded-2xl border border-border bg-background-card p-8 transition-all duration-200 hover:border-primary/20 md:p-10`}
                    >
                        <span class="mb-6 block font-Codesaver text-4xl font-bold text-primary/30 md:text-5xl">
                            {step.number}
                        </span>
                        <h3 class="mb-3 text-xl font-bold text-text-primary">
                            {step.title}
                        </h3>
                        <p class="text-sm leading-relaxed text-text-secondary md:text-base">
                            {step.description}
                        </p>
                    </article>
                ))
            }
        </div>
    </div>
</section>
