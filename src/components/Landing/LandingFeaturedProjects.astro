---
import { LANDING_FEATURED_PROJECTS } from "../../data/landing";
import LandingProjectsCarousel from "./LandingProjectsCarousel";
---

<section id="proyectos" aria-labelledby="projects-heading">
    <div class="section-container section-spacing">
        <div class="fade-in-up mb-10 text-center md:mb-16 lg:mb-20">
            <p class="eyebrow">Trabajo seleccionado</p>
            <h2 id="projects-heading" class="sectionTitle mb-4 md:mb-6">
                Proyectos que resolvieron un problema real
            </h2>
            <p class="section-subtitle mx-auto max-w-2xl text-sm md:text-base lg:text-lg">
                Cada caso nace de una necesidad concreta. Esto es lo que
                construimos — y por qué.
            </p>
        </div>

        <!-- Mobile: carrusel autoplay -->
        <div class="fade-in-up md:hidden">
            <LandingProjectsCarousel client:visible />
        </div>

        <!-- Desktop: casos de estudio apilados -->
        <div class="hidden flex-col gap-20 md:flex md:gap-28">
            {
                LANDING_FEATURED_PROJECTS.map((project, index) => {
                    const isReversed = index % 2 === 1;
                    return (
                        <article
                            class={`fade-in-up stagger-${Math.min(index + 1, 8)} grid min-w-0 grid-cols-1 items-center gap-10 lg:grid-cols-2 lg:gap-16 ${isReversed ? "lg:[direction:rtl]" : ""}`}
                        >
                            <div class={`min-w-0 ${isReversed ? "lg:[direction:ltr]" : ""}`}>
                                <figure class="group overflow-hidden rounded-2xl border border-border bg-background-card shadow-lg">
                                    <img
                                        src={project.image}
                                        alt={project.imageAlt}
                                        class="aspect-video w-full object-cover transition-transform duration-500 group-hover:scale-[1.02]"
                                        loading="lazy"
                                        decoding="async"
                                        width="800"
                                        height="450"
                                    />
                                </figure>
                            </div>

                            <div class={`min-w-0 space-y-6 ${isReversed ? "lg:[direction:ltr]" : ""}`}>
                                <div>
                                    <span class="mb-3 inline-block rounded-full border border-primary/20 bg-primary-light px-3 py-1 text-xs font-semibold text-primary">
                                        {project.category}
                                    </span>
                                    <h3 class="text-2xl font-bold text-text-primary md:text-3xl lg:text-4xl">
                                        {project.name}
                                    </h3>
                                    <p class="mt-3 text-base text-text-secondary md:text-lg">
                                        {project.description}
                                    </p>
                                </div>

                                <div class="space-y-4 rounded-2xl border border-border bg-background-dark p-6">
                                    <div>
                                        <p class="mb-1 text-xs font-semibold uppercase tracking-wider text-text-muted">
                                            Problema
                                        </p>
                                        <p class="text-sm leading-relaxed text-text-secondary md:text-base">
                                            {project.problem}
                                        </p>
                                    </div>
                                    <div class="h-px bg-border"></div>
                                    <div>
                                        <p class="mb-1 text-xs font-semibold uppercase tracking-wider text-text-muted">
                                            Solución
                                        </p>
                                        <p class="text-sm leading-relaxed text-text-secondary md:text-base">
                                            {project.solution}
                                        </p>
                                    </div>
                                    {
                                        project.result && (
                                            <>
                                                <div class="h-px bg-border" />
                                                <div>
                                                    <p class="mb-1 text-xs font-semibold uppercase tracking-wider text-text-muted">
                                                        Resultado
                                                    </p>
                                                    <p class="text-sm leading-relaxed text-text-secondary md:text-base">
                                                        {project.result}
                                                    </p>
                                                </div>
                                            </>
                                        )
                                    }
                                </div>

                                <a
                                    href={project.cta.href}
                                    target={project.cta.external ? "_blank" : undefined}
                                    rel={project.cta.external ? "noopener noreferrer" : undefined}
                                    class="inline-flex items-center gap-2 text-base font-semibold text-primary transition-all duration-200 hover:gap-3"
                                >
                                    {project.cta.label}
                                    <svg
                                        class="size-4"
                                        fill="none"
                                        stroke="currentColor"
                                        viewBox="0 0 24 24"
                                        aria-hidden="true"
                                    >
                                        <path
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            stroke-width="2"
                                            d="M17 8l4 4m0 0l-4 4m4-4H3"
                                        />
                                    </svg>
                                </a>
                            </div>
                        </article>
                    );
                })
            }
        </div>

        <div class="fade-in-up mt-10 text-center md:mt-16 lg:mt-20">
            <a href="/nuestros-proyectos" class="btn-secondary">
                Ver todos los proyectos
            </a>
        </div>
    </div>
</section>
