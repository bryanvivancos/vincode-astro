---
// Componente de Pricing reutilizable con datos dinámicos
import { WHATSAPP_NUMBER } from "../../CONSTANTS";

interface PricingPackage {
    id: number;
    name: string;
    description: string;
    price: number;
    originalPrice: number;
    discount: string;
    deliveryTime?: string;
    isPopular?: boolean;
    includes: string[];
    finalNote?: string;
    color?: "gray" | "primary" | "teal" | "purple" | "green";
}

interface Props {
    packages: PricingPackage[];
    serviceName?: string;
}

const { packages = [], serviceName = "este servicio" } = Astro.props;

const generateWhatsAppLink = (packageName: string) => {
    const message = `Hola, quiero solicitar el servicio ${serviceName} - ${packageName}`;
    return `https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(message)}`;
};

// Mapeo de colores
const colorMap = {
    gray: {
        header: "text-gray-700",
        bg: "bg-gray-700",
        button: "bg-gray-600 hover:bg-gray-700",
        badge: "bg-green-500",
        border: "border-gray-200",
    },
    primary: {
        header: "text-primary",
        bg: "bg-primary",
        button: "bg-primary hover:bg-primary-hover",
        badge: "bg-white text-primary",
        border: "border-primary",
    },
    teal: {
        header: "text-teal-600",
        bg: "bg-teal-500",
        button: "bg-teal-500 hover:bg-teal-600",
        badge: "bg-white text-teal-600",
        border: "border-teal-200",
    },
    purple: {
        header: "text-purple-600",
        bg: "bg-purple-500",
        button: "bg-purple-500 hover:bg-purple-600",
        badge: "bg-white text-purple-600",
        border: "border-purple-200",
    },
    green: {
        header: "text-green-600",
        bg: "bg-green-500",
        button: "bg-green-500 hover:bg-green-600",
        badge: "bg-white text-green-600",
        border: "border-green-200",
    },
};
---

<!-- Sección: Precios -->
<section id="pricing" class="py-20 md:py-24 bg-white">
    <div class="section-container">
        <div class="text-center mb-16">
            <h2
                class="text-3xl md:text-4xl font-bold text-text-primary leading-tight mb-4"
            >
                Precios y Paquetes
            </h2>
            <p class="text-lg text-text-secondary max-w-2xl mx-auto">
                Elige el plan que mejor se adapte a tus necesidades
            </p>
        </div>

        <div
            class={`grid grid-cols-1 gap-6 max-w-7xl mx-auto ${packages.length === 1 ? "md:grid-cols-1 max-w-md" : packages.length === 2 ? "md:grid-cols-2 max-w-4xl" : packages.length === 3 ? "md:grid-cols-3 max-w-6xl" : "md:grid-cols-2 lg:grid-cols-4"}`}
        >
            {
                packages.map((pkg) => {
                    const colors = colorMap[pkg.color || "gray"];
                    const borderClass =
                        pkg.isPopular && colors.border
                            ? colors.border
                            : "border-gray-200";

                    return (
                        <div
                            class={`bg-white rounded-3xl shadow-lg border-2 ${borderClass} overflow-hidden transition-all duration-300 hover:shadow-xl hover:scale-105 relative flex flex-col`}
                        >
                            {pkg.isPopular && (
                                <div
                                    class={`absolute top-0 right-0 ${colors.bg} text-white px-3 py-1 text-xs font-bold rounded-bl-lg z-10`}
                                >
                                    MÁS POPULAR
                                </div>
                            )}

                            <div class="bg-gray-100 px-6 py-5 text-center">
                                <h3
                                    class={`text-xl font-bold ${colors.header} uppercase tracking-wide`}
                                >
                                    {pkg.name}
                                </h3>
                            </div>

                            <div class={`${colors.bg} px-6 py-6 text-center`}>
                                <div class="text-white">
                                    <div class="text-sm line-through opacity-70 mb-1">
                                        Antes S/{" "}
                                        {pkg.originalPrice.toLocaleString()}
                                    </div>
                                    <div>
                                        <span class="text-3xl md:text-5xl font-black">
                                            S/ {pkg.price.toLocaleString()}
                                        </span>
                                    </div>
                                    <div
                                        class={`text-xs mt-2 ${colors.badge} inline-block px-3 py-1 rounded-full font-semibold`}
                                    >
                                        {pkg.discount}
                                    </div>
                                </div>
                            </div>

                            <div class="px-6 py-6 flex-grow flex flex-col">
                                <p class="text-gray-600 text-center mb-4 text-sm leading-relaxed">
                                    {pkg.description}
                                </p>

                                <ul class="space-y-2 mb-4 flex-grow">
                                    {pkg.includes.map((item) => (
                                        <li class="flex items-start gap-2">
                                            <svg
                                                class="w-5 h-5 text-green-500 flex-shrink-0 mt-0.5"
                                                fill="none"
                                                stroke="currentColor"
                                                viewBox="0 0 24 24"
                                            >
                                                <path
                                                    stroke-linecap="round"
                                                    stroke-linejoin="round"
                                                    stroke-width="2"
                                                    d="M5 13l4 4L19 7"
                                                />
                                            </svg>
                                            <span class="text-gray-700 text-sm">
                                                {item}
                                            </span>
                                        </li>
                                    ))}
                                </ul>

                                {pkg.deliveryTime && (
                                    <p class="text-xs text-gray-500 text-center mb-2">
                                        Entrega: {pkg.deliveryTime}
                                    </p>
                                )}

                                {pkg.finalNote && (
                                    <p class="text-xs text-gray-500 text-center mb-4 italic">
                                        {pkg.finalNote}
                                    </p>
                                )}

                                <a
                                    href={generateWhatsAppLink(pkg.name)}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    class={`block w-full py-3 ${colors.button} text-white font-bold rounded-full text-center transition-all duration-200 hover:scale-105 shadow-md text-sm mt-auto`}
                                >
                                    Solicitar
                                </a>
                            </div>
                        </div>
                    );
                })
            }
        </div>
    </div>
</section>
