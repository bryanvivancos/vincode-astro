---
// Componente de Pricing específico para la página Home
import { WHATSAPP_NUMBER } from "../../CONSTANTS";
import PricingCardsLayout from "./PricingCardsLayout.astro";

const generateWhatsAppLink = (packageName: string) => {
    const message = `Hola, quiero solicitar el paquete ${packageName}`;
    return `https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(message)}`;
};

const homePackageCount = 4;
---

<!-- Sección: Precios -->
<section id="precios" class="py-20 md:py-24 bg-[#f8f8fa]" aria-labelledby="pricing-heading">
    <div class="section-container">
        <div class="text-center mb-16 fade-in-up">
            <p class="eyebrow">Inversión</p>
            <h2
                id="pricing-heading"
                class="sectionTitle font-bold text-text-primary leading-tight mb-4"
            >
                Soluciones para diferentes etapas de tu negocio
            </h2>
            <p class="text-lg text-text-secondary max-w-2xl mx-auto">
                Estas son algunas formas de empezar con VINCODE. Elige el punto
                de partida que mejor se adapte a lo que necesitas. Si tu
                proyecto requiere algo más específico, lo construimos contigo.
            </p>
        </div>

        <PricingCardsLayout count={homePackageCount} interval={5000}>
            <!-- 1. PRESENCIA DIGITAL -->
            <div
                class="bg-[#f8f8fa] rounded-3xl shadow-2xl border-2 border-primary overflow-hidden transition-all duration-300 hover:shadow-2xl hover:scale-[1.02] relative flex flex-col h-full"
            >
                <div
                    class="absolute top-0 right-0 bg-primary text-white px-3 py-1 text-xs font-bold rounded-bl-lg z-10"
                >
                    MÁS ELEGIDO
                </div>
                <div class="bg-gray-100 px-6 py-5 text-center">
                    <h3
                        class="text-xl font-bold text-primary uppercase tracking-wide"
                    >
                        Presencia Digital
                    </h3>
                </div>
                <div class="bg-primary px-6 py-6 text-center">
                    <div class="text-white">
                        <div class="text-sm line-through opacity-70 mb-1">
                            Antes S/ 348
                        </div>
                        <p
                            class="text-xs mb-1.5 opacity-90 leading-snug px-1"
                        >
                            Precio referencial. El precio se adecua
                            tu negocio.
                        </p>
                        <div>
                            <span class="text-3xl md:text-5xl font-black"
                                >S/ 299</span
                            >
                        </div>
                        <div
                            class="text-xs mt-2 bg-[#f8f8fa] text-primary inline-block px-3 py-1 rounded-full font-semibold"
                        >
                            Ahorras S/ 49
                        </div>
                    </div>
                </div>
                <div class="px-6 py-6 flex-grow flex flex-col">
                    <p
                        class="text-gray-600 text-center mb-4 text-sm leading-relaxed"
                    >
                        Todo lo que necesitas para empezar a mostrar tu negocio
                        profesionalmente en internet
                    </p>
                    <ul class="space-y-2 mb-6 flex-grow">
                        <li class="flex items-start gap-2">
                            <svg
                                class="w-5 h-5 text-green-500 flex-shrink-0 mt-0.5"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M5 13l4 4L19 7"></path>
                            </svg>
                            <span class="text-gray-700 text-sm"
                                >Tarjeta Digital Básico</span
                            >
                        </li>
                        <li class="flex items-start gap-2">
                            <svg
                                class="w-5 h-5 text-green-500 flex-shrink-0 mt-0.5"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M5 13l4 4L19 7"></path>
                            </svg>
                            <span class="text-gray-700 text-sm"
                                >Link Bio Básico</span
                            >
                        </li>
                        <li class="flex items-start gap-2">
                            <svg
                                class="w-5 h-5 text-green-500 flex-shrink-0 mt-0.5"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M5 13l4 4L19 7"></path>
                            </svg>
                            <span class="text-gray-700 text-sm"
                                >QR, configuración e implementación</span
                            >
                        </li>
                    </ul>
                    <p class="text-xs text-gray-500 text-center mb-4 italic">
                        Tarjeta Digital Básico + Link Bio. No incluye panel
                        Admin.
                    </p>
                    <a
                        href={generateWhatsAppLink("Presencia Digital")}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="block w-full py-3 bg-primary hover:bg-primary-hover text-white font-bold rounded-full text-center transition-all duration-200 hover:scale-105 shadow-lg text-sm"
                    >
                        Solicitar
                    </a>
                </div>
            </div>

            <!-- 2. LANZAMIENTO DIGITAL -->
            <div
                class="bg-[#f8f8fa] rounded-3xl shadow-2xl border-2 border-orange-200 overflow-hidden transition-all duration-300 hover:shadow-2xl hover:scale-[1.02] relative flex flex-col h-full"
            >
                <div
                    class="absolute top-0 right-0 bg-orange-600 text-white px-3 py-1 text-xs font-bold rounded-bl-lg z-10"
                >
                    POPULAR
                </div>
                <div class="bg-gray-100 px-6 py-5 text-center">
                    <h3
                        class="text-xl font-bold text-orange-600 uppercase tracking-wide"
                    >
                        Lanzamiento Digital
                    </h3>
                </div>
                <div class="bg-orange-500 px-6 py-6 text-center">
                    <div class="text-white">
                        <div class="text-sm line-through opacity-70 mb-1">
                            Antes S/ 1,667
                        </div>
                        <p
                            class="text-xs mb-1.5 opacity-90 leading-snug px-1"
                        >
                            Precio referencial. El precio se adecua
                            tu negocio.
                        </p>
                        <div>
                            <span class="text-3xl md:text-5xl font-black"
                                >S/ 1,399</span
                            >
                        </div>
                        <div
                            class="text-xs mt-2 bg-[#f8f8fa] text-orange-600 inline-block px-3 py-1 rounded-full font-semibold"
                        >
                            Ahorras S/ 268
                        </div>
                    </div>
                </div>
                <div class="px-6 py-6 flex-grow flex flex-col">
                    <p
                        class="text-gray-600 text-center mb-4 text-sm leading-relaxed"
                    >
                        Para negocios que lanzan un producto o servicio y
                        necesitan convertir desde el primer día
                    </p>
                    <ul class="space-y-2 mb-6 flex-grow">
                        <li class="flex items-start gap-2">
                            <svg
                                class="w-5 h-5 text-green-500 flex-shrink-0 mt-0.5"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M5 13l4 4L19 7"></path>
                            </svg>
                            <span class="text-gray-700 text-sm"
                                >Setup Web</span
                            >
                        </li>
                        <li class="flex items-start gap-2">
                            <svg
                                class="w-5 h-5 text-green-500 flex-shrink-0 mt-0.5"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M5 13l4 4L19 7"></path>
                            </svg>
                            <span class="text-gray-700 text-sm"
                                >Landing Page</span
                            >
                        </li>
                        <li class="flex items-start gap-2">
                            <svg
                                class="w-5 h-5 text-green-500 flex-shrink-0 mt-0.5"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M5 13l4 4L19 7"></path>
                            </svg>
                            <span class="text-gray-700 text-sm"
                                >Tarjeta Digital Básico</span
                            >
                        </li>
                    </ul>
                    <p class="text-xs text-gray-500 text-center mb-4 italic">
                        Dominio, correos, landing page optimizada y tarjeta
                        digital. Listo para lanzar.
                    </p>
                    <a
                        href={generateWhatsAppLink("Lanzamiento Digital")}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="block w-full py-3 bg-orange-500 hover:bg-orange-600 text-white font-bold rounded-full text-center transition-all duration-200 hover:scale-105 shadow-lg text-sm"
                    >
                        Solicitar
                    </a>
                </div>
            </div>

            <!-- 3. PRESENCIA PROFESIONAL (paquete Presencia Pro) -->
            <div
                class="bg-[#f8f8fa] rounded-3xl shadow-2xl border-2 border-primary overflow-hidden transition-all duration-300 hover:shadow-2xl hover:scale-[1.02] relative flex flex-col h-full"
            >
                <div
                    class="absolute top-0 right-0 bg-primary text-white px-3 py-1 text-xs font-bold rounded-bl-lg z-10"
                >
                    POPULAR
                </div>
                <div class="bg-gray-100 px-6 py-5 text-center">
                    <h3
                        class="text-xl font-bold text-primary uppercase tracking-wide"
                    >
                        Presencia Pro
                    </h3>
                </div>
                <div class="bg-primary px-6 py-6 text-center">
                    <div class="text-white">
                        <div class="text-sm line-through opacity-70 mb-1">
                            Antes S/ 1,467
                        </div>
                        <p
                            class="text-xs mb-1.5 opacity-90 leading-snug px-1"
                        >
                            Precio referencial. El precio se adecua
                            tu negocio.
                        </p>
                        <div>
                            <span class="text-3xl md:text-5xl font-black"
                                >S/ 1,199</span
                            >
                        </div>
                        <div
                            class="text-xs mt-2 bg-[#f8f8fa] text-primary inline-block px-3 py-1 rounded-full font-semibold"
                        >
                            Ahorras S/ 268
                        </div>
                    </div>
                </div>
                <div class="px-6 py-6 flex-grow flex flex-col">
                    <p
                        class="text-gray-600 text-center mb-4 text-sm leading-relaxed"
                    >
                        La imagen completa que un profesional independiente
                        necesita
                    </p>
                    <ul class="space-y-2 mb-6 flex-grow">
                        <li class="flex items-start gap-2">
                            <svg
                                class="w-5 h-5 text-green-500 flex-shrink-0 mt-0.5"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M5 13l4 4L19 7"></path>
                            </svg>
                            <span class="text-gray-700 text-sm"
                                >Setup Web</span
                            >
                        </li>
                        <li class="flex items-start gap-2">
                            <svg
                                class="w-5 h-5 text-green-500 flex-shrink-0 mt-0.5"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M5 13l4 4L19 7"></path>
                            </svg>
                            <span class="text-gray-700 text-sm"
                                >Portfolio Profesional</span
                            >
                        </li>
                        <li class="flex items-start gap-2">
                            <svg
                                class="w-5 h-5 text-green-500 flex-shrink-0 mt-0.5"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M5 13l4 4L19 7"></path>
                            </svg>
                            <span class="text-gray-700 text-sm"
                                >Tarjeta Digital Básico</span
                            >
                        </li>
                    </ul>
                    <p class="text-xs text-gray-500 text-center mb-4 italic">
                        Dominio, correos, web con SEO y tarjeta para compartir.
                        Todo en uno.
                    </p>
                    <a
                        href={generateWhatsAppLink("Presencia Pro")}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="block w-full py-3 bg-primary hover:bg-primary-hover text-white font-bold rounded-full text-center transition-all duration-200 hover:scale-105 shadow-lg text-sm"
                    >
                        Solicitar
                    </a>
                </div>
            </div>

            <!-- 4. SOLUCIÓN A MEDIDA (sin precio inventado) -->
            <div
                class="bg-[#f8f8fa] rounded-3xl shadow-lg border-2 border-gray-200 overflow-hidden transition-all duration-300 hover:shadow-xl hover:scale-[1.02] flex flex-col h-full"
            >
                <div class="bg-gray-100 px-6 py-5 text-center">
                    <h3
                        class="text-xl font-bold text-gray-700 uppercase tracking-wide"
                    >
                        Solución a medida
                    </h3>
                </div>
                <div class="bg-gray-700 px-6 py-6 text-center">
                    <div class="text-white">
                        <p
                            class="text-xs mb-3 opacity-90 leading-snug px-1"
                        >
                            Sin precio fijo. Se define según tu proyecto.
                        </p>
                        <div>
                            <span class="text-2xl md:text-3xl font-black leading-tight"
                                >A medida</span
                            >
                        </div>
                    </div>
                </div>
                <div class="px-6 py-6 flex-grow flex flex-col">
                    <p
                        class="text-gray-600 text-center mb-6 text-sm leading-relaxed flex-grow"
                    >
                        Software, automatización e integraciones diseñadas
                        alrededor de las necesidades de tu negocio.
                    </p>
                    <a
                        href="/contacto"
                        class="block w-full py-3 bg-gray-600 hover:bg-gray-700 text-white font-bold rounded-full text-center transition-all duration-200 hover:scale-105 shadow-md text-sm"
                    >
                        Cuéntanos tu proyecto
                    </a>
                </div>
            </div>
        </PricingCardsLayout>
    </div>
</section>
