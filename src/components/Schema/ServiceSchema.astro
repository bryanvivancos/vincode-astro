---
interface PricingPackage {
    id: number;
    name: string;
    description: string;
    price: number;
    originalPrice: number;
    discount: string;
    deliveryTime?: string;
    isPopular?: boolean;
    includes: string[];
    finalNote?: string;
    color?: "gray" | "primary" | "teal" | "purple" | "green" | "orange";
}

interface Props {
    serviceName: string;
    serviceDescription: string;
    serviceCategory: string;
    canonicalUrl: string;
    pricing?: PricingPackage[];
}

const {
    serviceName,
    serviceDescription,
    serviceCategory,
    canonicalUrl,
    pricing = [],
} = Astro.props;

const organizationSchema = {
    "@context": "https://schema.org",
    "@type": "Organization",
    "@id": "https://www.vincode.dev/#organization",
    name: "Vincode",
    url: "https://www.vincode.dev",
    logo: {
        "@type": "ImageObject",
        url: "https://www.vincode.dev/vincode-icon.ico",
    },
    sameAs: ["https://www.instagram.com/vincodedev/"],
    contactPoint: {
        "@type": "ContactPoint",
        telephone: "+51-956-023-028",
        contactType: "customer service",
        areaServed: "PE",
        availableLanguage: ["es", "en"],
    },
};

const serviceSchema = {
    "@context": "https://schema.org",
    "@type": "Service",
    "@id": canonicalUrl,
    name: serviceName,
    description: serviceDescription,
    provider: {
        "@id": "https://www.vincode.dev/#organization",
    },
    areaServed: {
        "@type": "Country",
        name: "Perú",
    },
    serviceType: serviceCategory,
    url: canonicalUrl,
    ...(pricing &&
        pricing.length > 0 && {
            offers: pricing.map((pkg) => ({
                "@type": "Offer",
                name: pkg.name,
                description: pkg.description,
                price: pkg.price.toFixed(2),
                priceCurrency: "PEN",
                availability: "https://schema.org/InStock",
                validFrom: new Date().toISOString().split("T")[0],
                priceValidUntil: new Date(
                    new Date().setFullYear(new Date().getFullYear() + 1),
                )
                    .toISOString()
                    .split("T")[0],
                seller: {
                    "@id": "https://www.vincode.dev/#organization",
                },
            })),
        }),
};

const breadcrumbSchema = {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
        {
            "@type": "ListItem",
            position: 1,
            name: "Inicio",
            item: {
                "@id": "https://www.vincode.dev/",
                name: "Inicio",
            },
        },
        {
            "@type": "ListItem",
            position: 2,
            name: "Servicios",
            item: {
                "@id": "https://www.vincode.dev/servicios",
                name: "Servicios",
            },
        },
        {
            "@type": "ListItem",
            position: 3,
            name: serviceName,
            item: {
                "@id": canonicalUrl,
                name: serviceName,
            },
        },
    ],
};
---

<script
    type="application/ld+json"
    set:html={JSON.stringify(organizationSchema)}
/>
<script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
<script
    type="application/ld+json"
    set:html={JSON.stringify(breadcrumbSchema)}
/>
