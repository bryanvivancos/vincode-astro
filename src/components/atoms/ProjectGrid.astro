---
import Gallery from './Gallery.astro';

interface Project {
    title: string;
    description: string;
    img: string;
    url: string;
    goToWeb: boolean;
}

interface Props {
    projects: Project[];
}

const { projects } = Astro.props;
---

<div
    class="grid gap-4 grid-cols-[repeat(auto-fit,minmax(210px,1fr))] place-items-center mt-6"
>
    {
        projects.map((project: Project) => (
            <div class="bg-background-card border border-border rounded-lg p-4 flex flex-col gap-3 transition-all transform duration-300 ease-in-out hover:border-primary hover:-translate-y-1 animate-slide-in-top max-w-72 h-full group">
                <div class="flex flex-col gap-1">
                    {/* <img
                        src={project.img}
                        alt={`${project.title} screenshot`}
                        class="w-full h-auto rounded-lg"
                    /> */}
                    <Gallery 
                        img= {project.imgGallery}
                    />
                    <a class="pt-4 space-y-2"
                        href={project.url}
                        target="_blank"
                    >
                        <h4 class="text-base font-bold leading-5 text-text-primary">
                            {project.title}
                        </h4>
                        <p class="text-sm font-medium leading-5 text-text-secondary">
                            {project.description}
                        </p>
                        <div
                            class={`text-sm group-hover:text-base transition-all duration-300 ease-in-out
                                ${project.goToWeb === true ? "text-primary font-bold" : "text-slate-300 font-bold pointer-events-none"}`}
                        >
                            {project.goToWeb ? (
                                <>Echar un Vistazo</>
                            ) : (
                                <> Preguntar por el Servicio</>
                            )}
                        </div>
                    </a>
                </div>
            </div>
        ))
    }
</div>
