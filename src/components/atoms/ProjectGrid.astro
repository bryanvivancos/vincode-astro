---
interface Project {
    title: string;
    description: string;
    img: string;
    url: string;
    goToWeb: boolean;
}

interface Props {
    projects: Project[]
}


const { projects } = Astro.props
---

<div class="grid gap-4 grid-cols-[repeat(auto-fit,minmax(210px,1fr))] place-items-center mt-6">
    {
        projects.map((project:Project) => (
            <div
                class="bg-background-card border border-border rounded-lg p-4 flex flex-col gap-3 transition-all transform duration-300 ease-in-out hover:border-primary hover:-translate-y-1 animate-slide-in-top h-full"
            >
                <div class="flex flex-col gap-1">
                    <img
                        src={project.img}
                        alt={`${project.title} screenshot`}
                        class="w-full h-auto rounded-lg"
                    />
                    <div class="pt-4 space-y-2">
                        <h4 class="text-base font-bold leading-5 text-text-primary">
                            {project.title}
                        </h4>
                        <p class="text-sm font-medium leading-5 text-text-secondary">
                            {project.description}
                        </p>
                        <a href={project.url}
                            target="_blank"
                            class={`${project.goToWeb === true ? "text-primary font-bold" : "text-slate-300 font-bold pointer-events-none"} text-sm`}>
                            { project.goToWeb 
                                ? <>Ir al Sitio</> 
                                : <> Preguntar por el Servicio</>
                            }
                        </a>
                    </div>
                </div>
            </div>
        ))
    }
</div>