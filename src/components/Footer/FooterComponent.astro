---
import { Icon } from "../icons/Icon";
import { navbar_items, VINCODE_IG } from "../../CONSTANTS";

const pathname = Astro.url.pathname;
const currentSegment = pathname.replace(/\/$/, "").split("/")[1] ?? "";
---

<footer class="py-16 sm:py-20 md:py-24">
    <div class="section-container">
        <div class="divider mb-12"></div>

        <div class="flex flex-col gap-10 items-center">
            {
                pathname !== "/" && (
                    <div class="flex flex-wrap justify-center gap-6 md:gap-10">
                        {navbar_items.map((item) => (
                            <a
                                href={`/${item.htmlId}`}
                                class={`text-sm md:text-base font-medium transition-all duration-300 ease-out
                                    ${currentSegment === item.htmlId ? "text-primary" : "text-text-secondary hover:text-primary hover:translate-y-[-2px]"}`}
                            >
                                {item.name}
                            </a>
                        ))}
                    </div>
                )
            }

            <div class="flex gap-5 items-center">
                <a
                    href={VINCODE_IG}
                    target="_blank"
                    class="w-10 h-10 rounded-xl bg-white/5 flex items-center justify-center transition-all duration-300 ease-out hover:bg-primary/20 hover:scale-110"
                    aria-label="Instagram"
                >
                    <Icon
                        name="InstagramIcon"
                        width={22}
                        height={22}
                        color="#91B8C9"
                    />
                </a>
            </div>

            <p class="text-sm font-medium text-text-secondary/70 text-center">
                © 2025 Vincode. Todos los derechos reservados.
            </p>
        </div>
    </div>
</footer>
