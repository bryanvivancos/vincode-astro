---
import { ClickIcon, DashboardIcon, GlobeIcon, MobileIcon } from '../components/icons';
import { ServicesPageTemplate } from '../components/Services/ServicesPageTemplate'
import { BRAND_NAME, LINK_BIO_SUBTITLES, LINK_BIO_TITLES } from '../CONSTANTS';
import MainLayout from '../layouts/MainLayout.astro';

const benefits = [
  {
    id: 1,
    icon: GlobeIcon,
    title: 'Mayor Alcance y Conexión',
    description: 'Concentra todos tus enlaces importantes en un solo lugar, facilitando que tus seguidores y clientes accedan fácilmente a todo lo que ofreces.',
  },
  {
    id: 2,
    icon: ClickIcon,
    title: 'Aumenta Tus Conversiones',
    description: 'Diseños optimizados para captar la atención y dirigir al usuario hacia la acción: más clics, más ventas, más interacción.',
  },
  {
    id: 3,
    icon: DashboardIcon,
    title: 'Personalización Total',
    description: 'Adaptamos tu Links in Bio a tu estilo visual, marca personal o identidad corporativa. Desde colores y tipografía hasta íconos y botones de acción.'
  },
  {
    id: 4,
    icon: MobileIcon,
    title: 'Optimizado para Todos los Dispositivos',
    description: 'Tu Links in Bio lucirá perfectamente en cualquier pantalla — móvil, tablet o escritorio — asegurando una experiencia fluida y profesional.'
  }
]

const projects = [
  {
    title: 'Link in Bio',
    description: 'Déjanos crear un centro para todos tus enlaces importantes.',
    img: '/link_bio.webp'
  },
];

const faqData = [
  {
    id: 1,
    question: '¿Qué incluye exactamente el servicio de Link in Bio?',
    answer: 'Incluye diseño personalizado, estructura optimizada, enlaces organizados, botones de acción, integración con redes sociales y versión adaptable para móviles.',
  },
  {
    id: 2,
    question: '¿Puedo actualizar mis enlaces cuando quiera?',
    answer: 'Sí. Dependiendo del plan, podrás editar tus enlaces tú mismo desde un panel simple, o podrás solicitar cambios directamente a nosotros.',
  },
  {
    id: 3,
    question: '¿Mi Link in Bio funcionará en Instagram, TikTok y otras redes?',
    answer: 'Totalmente. Es compatible con todas las plataformas que permiten un único enlace en la biografía.',
  },
  {
    id: 4,
    question: '¿Cuánto tiempo demora la creación de mi Link in Bio?',
    answer: 'Usualmente entre 3 y 5 días, dependiendo del diseño y la cantidad de enlaces.',
  },
];

const title = "Servicio de Links in Bio"
---

<MainLayout 
    title={`${title} | ${BRAND_NAME}`} 
    description="Diseñamos tu Links in Bio con una estética moderna, adaptable a tu marca y optimizada para convertir visitas en acciones concretas — ya sea dirigir tráfico a tus redes, ventas, servicios o contenido destacado."
    url="https://www.vincode.dev/services/link-bio">
    
    <ServicesPageTemplate
        title= {title}
        subtitles={LINK_BIO_TITLES}
        description={LINK_BIO_SUBTITLES}
        demos='Link in Bios'
        profits={benefits}
        projects={projects}
        faqsItems={faqData}
    />
</MainLayout>
